                                            'absent\\n    # If present, we set it to 1 (a non-IEEE mode in fdlibm/glibc), ensuring the guard `_LIB_VERSION == '
                                            '_IEEE_` is false.\\n    tmpdir = tempfile.mkdtemp(prefix=\\"preload_libversion_\\")\\n    c_path = '
                                            'os.path.join(tmpdir, \\"set_lib_version.c\\")\\n    so_path = os.path.join(tmpdir, '
                                            '\\"libsetlibversion.so\\")\\n    c_code = r\'\'\'\\n    __attribute__((weak)) extern int _LIB_VERSION;\\n    '
                                            'static void set_ver(void) __attribute__((constructor));\\n    static void set_ver(void) {\\n        if '
                                            '(&_LIB_VERSION) {\\n            // Set to a non-IEEE value; 1 corresponds to a non-IEEE mode (_XOPEN_ '
                                            'typically).\\n            _LIB_VERSION = 1;\\n        }\\n    }\\n    \'\'\'\\n    with open(c_path, \\"w\\", '
                                            'encoding=\\"utf-8\\") as f:\\n        f.write(textwrap.dedent(c_code))\\n\\n    # Attempt to compile with a '
                                            'suitable C compiler available\\n    compilers = [os.environ.get(\\"CC\\"), \\"cc\\", \\"gcc\\", '
                                            '\\"clang\\"]\\n    compile_ok = False\\n    last_err = None\\n    for cc in compilers:\\n        if not '
                                            'cc:\\n            continue\\n        try:\\n            res = subprocess.run(\\n                [cc, '
                                            '\\"-shared\\", \\"-fPIC\\", \\"-O2\\", \\"-o\\", so_path, c_path],\\n                '
                                            'capture_output=True,\\n                encoding=\\"utf-8\\",\\n                '
                                            'errors=\\"replace\\",\\n                check=False,\\n            )\\n            if res.returncode == 0 and '
                                            'os.path.exists(so_path):\\n                compile_ok = True\\n                break\\n            '
                                            'else:\\n                last_err = f\\"compiler {cc} failed: {res.stderr}\\\\n{res.stdout}\\"\\n        except '
                                            'Exception as e:\\n            last_err = f\\"compiler {cc} exception: {e}\\"\\n    if not compile_ok:\\n        # '
                                            'Clean up before failing to provide a clear error message\\n        shutil.rmtree(tmpdir, '
                                            'ignore_errors=True)\\n        raise RuntimeError(f\\"Failed to build preload library to set _LIB_VERSION. '
                                            'Details: {last_err}\\")\\n\\n    # 2) Prepare environment to ensure correct numeric parsing and preload our '
                                            "library\\n    env = os.environ.copy()\\n    # Ensure '.' is decimal separator and avoid locales with ','\\n    "
                                            'env[\\"LC_ALL\\"] = \\"C\\"\\n    env[\\"LC_NUMERIC\\"] = \\"C\\"\\n    env[\\"LANG\\"] = \\"C\\"\\n    # Preload '
                                            'our initializer so _LIB_VERSION != _IEEE_\\n    existing_preload = env.get(\\"LD_PRELOAD\\", \\"\\")\\n    '
                                            'env[\\"LD_PRELOAD\\"] = so_path if not existing_preload else (so_path + \\":\\" + existing_preload)\\n\\n    # 3) '
                                            'Run the original test harness command unmodified so argv[1]==\\"1.0\\" and argv[2]==\\"1.0\\"\\n    '
                                            'try:\\n        result = subprocess.run(\\n            [\\"./temp_executable 1.0 1.0\\"],\\n            '
                                            'capture_output=True,\\n            encoding=\\"utf-8\\",\\n            errors=\\"replace\\",\\n            '
                                            'shell=True,\\n            timeout=timeout,\\n            env=env,\\n        )\\n        return result.stderr, '
                                            'result.returncode\\n    except subprocess.TimeoutExpired as e:\\n        return e.stderr, -signal.SIGKILL\\n    '
                                            'except Exception:\\n        # Ensure cleanup then re-raise\\n        raise\\n    finally:\\n        # Clean up '
                                            'build artifacts; keep the temp dir if needed for diagnostics by commenting out\\n        shutil.rmtree(tmpdir, '
                                            'ignore_errors=True)\\n"}'}}]},
