import struct

def hi_word(val):
    b = struct.pack('<d', float(val))  # little-endian double
    hi = struct.unpack('<I', b[4:8])[0]
    return hi

vals = [9e300, 8e300, 1e300, 1.1e300]
for v in vals:
    print(v, hex(hi_word(v)))

# Differences
h9 = hi_word(9e300)
h8 = hi_word(8e300)
print('diff 9e300-8e300:', hex(h9-h8))

h1 = hi_word(1e300)
h11 = hi_word(1.1e300)
print('diff 1.1e300-1e300:', hex(h11-h1))

print('threshold 0x5f300000:', hex(0x5f300000))
print('fast path limit 0x3c00000:', hex(0x3c00000))
