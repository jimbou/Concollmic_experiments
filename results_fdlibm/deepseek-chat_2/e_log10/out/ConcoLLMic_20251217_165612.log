import struct

def check_float_bits(value_str):
    try:
        # Convert string to float
        float_val = float(value_str)
        # Get the double-precision representation
        bits = struct.unpack('>Q', struct.pack('>d', float_val))[0]
        # Extract high 32 bits
        hx = bits >> 32
        print(f"String: '{value_str}' -> Float: {float_val}")
        print(f"Bits: 0x{bits:016x}")
        print(f"High 32 bits (hx): 0x{hx:08x}")
        print(f"hx >= 0x7ff00000: {hx >= 0x7ff00000}")
        print("-" * 50)
        return hx >= 0x7ff00000
    except ValueError as e:
        print(f"Error converting '{value_str}': {e}")
        return False

# Test various special floating-point representations
test_values = ["inf", "infinity", "-inf", "-infinity", "nan", "NaN", "INF"]

