import struct

# Function to get the high 32 bits of a double
# This simulates what the C code would do with hx = *(int*)&x

def get_high_bits(x):
    # Convert double to 64-bit representation
    packed = struct.pack('d', x)
    # Get the high 32 bits (first 4 bytes in little-endian)
    high_bits = struct.unpack('I', packed[4:])[0] if struct.pack('@I', 1) == struct.pack('<I', 1) else struct.unpack('I', packed[:4])[0]
    # Extract without sign bit (mask out the sign bit)
    return high_bits & 0x7fffffff

