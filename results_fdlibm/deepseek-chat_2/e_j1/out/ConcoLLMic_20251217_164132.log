# Let's verify what the constraint ix >= 0x40000000 means
# This is checking the high-order bits of a double-precision float

import struct

# Convert 0x40000000 to understand what it represents
# In IEEE 754 double precision, the exponent bias is 1023
# 0x40000000 in the high-order bits represents exponent = 1024 (since 0x40000000 >> 20 = 1024)
# The actual value is 2^(1024-1023) = 2^1 = 2.0

# Let's test some values
values = [1.0, 2.0, 2.5, 3.0, -2.0, -2.5, -3.0]

for val in values:
    # Convert to IEEE 754 double representation
    hex_repr = struct.unpack('>Q', struct.pack('>d', val))[0]
    # Get the high-order 32 bits (ix = hx & 0x7fffffff)
    hx = hex_repr >> 32
    ix = hx & 0x7fffffff
    
    print(f"Value: {val:5.1f}, ix: 0x{ix:08x}, ix >= 0x40000000: {ix >= 0x40000000}")
