# Create a simple C program to test atof() behavior
test_c_code = '''
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <number>\\n", argv[0]);
        return 1;
    }
    
    double value = atof(argv[1]);
    
    // Check if it's infinity
    if (isinf(value)) {
        printf("INFINITY\\n");
    }
    // Check if it's NaN
    else if (isnan(value)) {
        printf("NAN\\n");
    }
    else {
        printf("NORMAL: %f\\n", value);
    }
    
    return 0;
}
'''

# Write the test program
with open('test_atof.c', 'w') as f:
    f.write(test_c_code)

# Compile it
subprocess.run(['gcc', 'test_atof.c', '-o', 'test_atof', '-lm'])

# Test various strings
test_strings = [
    "inf", "infinity", "INF", "INFINITY",
    "nan", "NAN", "NaN",
    "1.#INF", "1.#QNAN", "1.#IND",
    "1e999", "-1e999"  # Very large numbers that might overflow to inf
]

print("Testing atof() behavior with various strings:")
for test_str in test_strings:
    try:
        result = subprocess.run(
            ['./test_atof', test_str],
            capture_output=True,
            text=True,
            timeout=5
        )
        print(f"'{test_str}' -> {result.stdout.strip()}")
    except Exception as e:
        print(f"'{test_str}' -> Error: {e}")

# Clean up
import os
if os.path.exists('test_atof.c'):
    os.remove('test_atof.c')
if os.path.exists('test_atof'):
    os.remove('test_atof')
