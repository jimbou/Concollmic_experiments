import struct

# Convert 0x5f300000 to a floating-point value
# Since this is a 32-bit value but we're dealing with doubles, I need to understand this properly
# In IEEE 754 double-precision, the high 32 bits contain the sign, exponent, and part of the mantissa

# Let me first see what 0x5f300000 represents as a float
hex_value = 0x5f300000
print(f"Hex value: 0x{hex_value:08x}")
print(f"Decimal value: {hex_value}")

# This appears to be a bit pattern for the high 32 bits of a double
# Let me construct a double from this high part and zeros for the low part
high_bits = hex_value
low_bits = 0x00000000

# Combine to form a 64-bit double
combined = (high_bits << 32) | low_bits

# Convert to double
float_value = struct.unpack('d', struct.pack('Q', combined))[0]
print(f"Floating-point value: {float_value}")
print(f"Scientific notation: {float_value:e}")

# Also let me check what the threshold 0x5f300000 means in terms of floating-point magnitude
# The exponent part of 0x5f300000 in IEEE 754 double:
# Sign bit: 0 (positive)
# Exponent: 0x5f3 = 1523 in decimal
# Actual exponent = 1523 - 1023 = 500
# So this represents numbers around 2^500 which is HUGE (~3.27e+150)

exponent_bits = (hex_value >> 20) & 0x7FF  # Get the 11 exponent bits
actual_exponent = exponent_bits - 1023  # Subtract bias
print(f"Exponent bits: {exponent_bits}")
print(f"Actual exponent: {actual_exponent}")
print(f"Approximate value: 2^{actual_exponent} ≈ {2.0 ** actual_exponent}")
