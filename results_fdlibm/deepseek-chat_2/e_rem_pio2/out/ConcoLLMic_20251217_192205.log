import struct

# Convert hex values to actual floating-point numbers
def hex_to_float(hex_val):
    # Convert hex to bytes (assuming little-endian)
    # For the high 32 bits, we need to construct the full 64-bit representation
    # Let's assume the lower 32 bits are 0
    full_bytes = struct.pack('<Q', (hex_val << 32))
    return struct.unpack('d', full_bytes)[0]

