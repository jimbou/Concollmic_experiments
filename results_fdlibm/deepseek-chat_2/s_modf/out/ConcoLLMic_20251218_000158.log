import z3

# We need to find a double-precision floating-point number where the exponent field > 51
# The exponent field is calculated as: j0 = ((__HI(x) >> 20) & 0x7ff) - 0x3ff > 51
# This means j0 > 51, so ((__HI(x) >> 20) & 0x7ff) - 0x3ff > 51
# Which simplifies to: ((__HI(x) >> 20) & 0x7ff) > 51 + 0x3ff = 51 + 1023 = 1074

# Let's work with the actual IEEE 754 representation
# For double-precision floating-point:
# - Sign bit: 1 bit
# - Exponent: 11 bits (bias 1023)
# - Mantissa: 52 bits

# We want exponent field > 1074 (which is 51 + 1023)
# The maximum exponent in double-precision is 2047 (0x7ff), but values 2047 are reserved for NaN/inf
# So we need exponent between 1075 and 2046 inclusive

# Let's create a symbolic double value
x = z3.FP('x', z3.Float64())

# Constraint: x is finite (not NaN, not infinity)
finite_constraint = z3.And(z3.fpIsNormal(x) | z3.fpIsSubnormal(x))

# Constraint: x has no fractional part (is an integer)
# This means the mantissa should represent an integer value
# For numbers with exponent > 51, the number is so large that the fractional precision is lost
# So any number with exponent > 51 will automatically have no fractional part

# Constraint: exponent > 51
# In IEEE 754, the actual exponent = stored_exponent - 1023
# So we need stored_exponent > 51 + 1023 = 1074

# Extract the exponent bits
# We'll create a bit-vector representation and extract the exponent
bv_x = z3.fpToIEEEBV(x)
# Double: 1 sign bit, 11 exponent bits, 52 mantissa bits
exponent_bits = z3.Extract(62, 52, bv_x)  # bits 62-52 (11 bits)

# Convert to integer
exponent_val = z3.BV2Int(exponent_bits)

# Constraint: exponent_val > 1074 and exponent_val < 2047 (not NaN/inf)
exponent_constraint = z3.And(exponent_val > 1074, exponent_val < 2047)

# Also ensure the number is positive (to avoid sign issues)
positive_constraint = z3.fpIsPositive(x)

# Final constraint
final_constraint = z3.And(finite_constraint, exponent_constraint, positive_constraint)
