import struct
import math

# Function to get the high 32 bits of a double (masking out sign bit)
def get_high_bits(f):
    # Convert float to IEEE 754 double representation
    bits = struct.unpack('>Q', struct.pack('>d', f))[0]
    # Get high 32 bits (bits 63-32) and mask out sign bit (bit 63)
    high_bits = (bits >> 32) & 0x7FFFFFFF
    return high_bits

# Function to get the low 32 bits of a double
def get_low_bits(f):
    bits = struct.unpack('>Q', struct.pack('>d', f))[0]
    low_bits = bits & 0xFFFFFFFF
    return low_bits

# Test various special values
print("Testing special IEEE 754 values:")
print("-" * 50)

# Test infinity
inf = float('inf')
print(f"inf: high_bits = 0x{get_high_bits(inf):08x}, low_bits = 0x{get_low_bits(inf):08x}")

# Test NaN
nan = float('nan')
