# Test what NaN representations are accepted by Python's float parsing
import struct
import math

# Test various NaN representations
nan_values = [
    "nan",
    "NaN", 
    "NAN",
    "+nan",
    "-nan",
    "1.#QNAN",
    "1.#IND",
    "inf",  # Also test infinity
    "Inf",
    "INF",
    "+inf",
    "-inf"
]

print("Testing float parsing:")
for val in nan_values:
    try:
        f = float(val)
        print(f"'{val}' -> {f} (isnan: {math.isnan(f)}, isinf: {math.isinf(f)})")
    except ValueError as e:
        print(f"'{val}' -> ERROR: {e}")

# Also test creating actual NaN values and their string representations
print("\nTesting NaN representations:")
import ctypes

# Create a NaN value by manipulating bits
nan_double = struct.unpack('d', struct.pack('Q', 0x7FF0000000000001))[0]
print(f"NaN from bits 0x7FF0000000000001: {nan_double} (isnan: {math.isnan(nan_double)})")

# Test if we can convert NaN back to string and parse it
nan_str = str(nan_double)
print(f"String representation of NaN: '{nan_str}'")
try:
    parsed = float(nan_str)
    print(f"Parsed back: {parsed} (isnan: {math.isnan(parsed)})")
except:
    print("Could not parse back")
