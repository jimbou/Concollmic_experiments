import struct

def get_ieee754_exponent(x):
    """Get the IEEE 754 exponent field for a double-precision float"""
    # Pack the float as double (8 bytes)
    packed = struct.pack('d', x)
    # Unpack as unsigned long long to get the bits
    bits = struct.unpack('Q', packed)[0]
    # Extract exponent field (bits 52-62)
    exponent = (bits >> 52) & 0x7FF
    return exponent

# Test some values to understand the exponent range
test_values = [1.0, 2.0, 100.0, 1000.0, 10000.0, 100000.0, 500000.0, 524288.0, 1048576.0]

print("Testing IEEE 754 exponent fields:")
for val in test_values:
    exp = get_ieee754_exponent(val)
    actual_exp = exp - 1023  # Remove bias
    print(f"{val:10.1f} -> exponent field: {exp:4d}, actual exponent: {actual_exp:3d}")

print("\nRequired range: exponent field 1023-1042 (actual exponent 0-19)")
print("This corresponds to values between 1.0 and 524288.0")
