import struct
import math

def get_j0(value):
    """Get j0 value from IEEE 754 double representation"""
    packed = struct.pack('d', value)
    int_repr = struct.unpack('Q', packed)[0]
    exponent = (int_repr >> 52) & 0x7FF
    j0 = exponent - 1023
    return j0

# Test various values to understand the threshold
test_values = [
    1.0,
    1000.0,
    1e15,
    2.0**50,   # 2^50
    2.0**51,   # 2^51
    2.0**52,   # 2^52
    1e16,
    1e20,
    1e100,
    1e200,
    1.8e308,   # close to max normal
    float('inf')
]

