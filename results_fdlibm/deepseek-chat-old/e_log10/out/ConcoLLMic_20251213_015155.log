import struct

def test_atof_representation(s):
    try:
        # Use Python's float() which should be similar to atof()
        f = float(s)
        # Get the IEEE 754 representation
        packed = struct.pack('d', f)
        # Unpack as unsigned long long to get the bits
        bits = struct.unpack('Q', packed)[0]
        # Extract high 32 bits
        hx = bits >> 32
        
        print(f"String: '{s}' -> Float: {f}")
        print(f"  High 32 bits (hx): 0x{hx:08x}")
