import struct

# Test with explicit endianness handling
def test_with_endianness():
    value = 1.0
    
    # Pack as big-endian
    packed_be = struct.pack('>d', value)  # Big-endian
    hex_be = ''.join(f'{b:02x}' for b in packed_be)
    
    # Pack as little-endian  
    packed_le = struct.pack('<d', value)  # Little-endian
    hex_le = ''.join(f'{b:02x}' for b in packed_le)
    
    print(f"Value: {value}")
    print(f"Big-endian hex:    {hex_be}")
    print(f"Little-endian hex: {hex_le}")
    
    # Check the target constraint requirements
    # High 32 bits should be 0x3FF00000, low 32 bits should be 0x00000000
    # This is the big-endian representation
    
    if hex_be == "3ff0000000000000":
        print("✓ Big-endian representation matches target constraint")
        
        # Extract high and low 32 bits
        high_32 = hex_be[:8]  # First 8 hex digits (32 bits)
        low_32 = hex_be[8:]   # Last 8 hex digits (32 bits)
        
        print(f"High 32 bits: 0x{high_32}")
        print(f"Low 32 bits: 0x{low_32}")
        
        if high_32 == "3ff00000" and low_32 == "00000000":
            print("✓ High and low bits match target constraint exactly")
            return True
    
    return False

test_with_endianness()
