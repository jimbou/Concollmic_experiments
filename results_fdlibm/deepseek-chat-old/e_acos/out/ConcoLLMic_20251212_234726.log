import struct

# Test if "1.0" converts to exact double-precision 1.0
def test_double_conversion():
    # Convert "1.0" to double using Python's float (which should be similar to atof)
    value = float("1.0")
    
    # Get the IEEE 754 representation
    packed = struct.pack('d', value)
    hex_representation = ''.join(f'{b:02x}' for b in packed)
    
    # For little-endian systems, the high 32 bits are the last 8 hex digits
    # For big-endian systems, the high 32 bits are the first 8 hex digits
    # Let's check both interpretations
    
    print(f"String: '1.0'")
    print(f"Float value: {value}")
    print(f"Hex representation: {hex_representation}")
    
    # Check if it matches the expected pattern for 1.0
    # 1.0 in IEEE 754 double: 0x3FF0000000000000
    expected_hex = "3ff0000000000000"
    
    if hex_representation == expected_hex:
        print("✓ SUCCESS: '1.0' converts to exact double-precision 1.0")
        return True
    else:
        print(f"✗ FAILED: Expected {expected_hex}, got {hex_representation}")
        return False

# Test also with other representations
def test_other_representations():
    test_strings = ["1", "1.0", "1.0000000000000000"]
    
    for test_str in test_strings:
        value = float(test_str)
        packed = struct.pack('d', value)
        hex_rep = ''.join(f'{b:02x}' for b in packed)
        
        print(f"\nTesting '{test_str}':")
        print(f"  Value: {value}")
        print(f"  Hex: {hex_rep}")
        print(f"  Matches 1.0: {hex_rep == '3ff0000000000000'}")

test_double_conversion()
test_other_representations()
