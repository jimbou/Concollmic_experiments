import struct

def test_float_representation(value_str):
    """Test the IEEE 754 representation of a float string"""
    try:
        # Parse the string as float
        value = float(value_str)
        
        # Get IEEE 754 representation
        packed = struct.pack('d', value)
        # For double precision (64-bit), get the high word (last 4 bytes on big-endian systems)
        # On little-endian systems, the high word is the last 4 bytes
        high_word = struct.unpack('>I', packed[4:8])[0]  # Big-endian unpack of last 4 bytes
        
        # Check if sign bit is set (bit 31 in the high word)
        sign_bit_set = (high_word & 0x80000000) != 0
        
        print(f"Value: {value_str}")
        print(f"Parsed as: {value}")
        print(f"High word (hex): {hex(high_word)}")
        print(f"Sign bit set: {sign_bit_set}")
        print(f"Is negative: {value < 0}")
        print("---")
        
        return sign_bit_set and value < 0
        
