import struct

def test_double_representation(value_str):
    """Test the IEEE 754 double-precision representation"""
    try:
        # Parse the string as float
        value = float(value_str)
        
        # Get IEEE 754 double representation (64 bits)
        packed = struct.pack('d', value)
        
        # For IEEE 754 double:
        # - Sign bit: bit 63 (most significant bit)
        # - Exponent: bits 62-52
        # - Mantissa: bits 51-0
        
        # Convert to integer representation to check bits
        int_repr = struct.unpack('Q', packed)[0]  # Q = unsigned long long (64 bits)
        
        # Check sign bit (bit 63)
        sign_bit_set = (int_repr & 0x8000000000000000) != 0
        
        print(f"Value: {value_str}")
        print(f"Parsed as: {value}")
        print(f"64-bit representation (hex): {hex(int_repr)}")
        print(f"Sign bit (bit 63) set: {sign_bit_set}")
        print(f"Is negative: {value < 0}")
        
        # Also check the high word (32 most significant bits)
        high_word = (int_repr >> 32) & 0xFFFFFFFF
        high_word_sign_bit = (high_word & 0x80000000) != 0
        print(f"High word (32 MSB, hex): {hex(high_word)}")
        print(f"High word sign bit (bit 31) set: {high_word_sign_bit}")
        print("---")
        
        return sign_bit_set and value < 0
        
    except Exception as e:
        print(f"Error parsing {value_str}: {e}")
        return False

# Test various negative floating-point numbers
test_values = ["-1.0", "-2.5", "-0.001", "-inf", "-0.0", "-1e-10", "-1000.0", "-3.14159"]

print("Testing IEEE 754 double-precision representations:")
print("=" * 60)

for val in test_values:
    test_double_representation(val)
