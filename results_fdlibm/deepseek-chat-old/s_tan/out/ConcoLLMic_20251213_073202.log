import struct

def check_float_constraint(value_str):
    """Check if a string value satisfies the floating-point constraint"""
    try:
        # Convert string to float
        value = float(value_str)
        
        # Convert to double precision IEEE 754 representation
        packed = struct.pack('d', value)
        
        # Extract high 32 bits (assuming little-endian)
        # For double: bytes 4-7 are the high 32 bits in little-endian
        high_bits = struct.unpack('<I', packed[4:8])[0]
        
        # Check the condition: (ix & 0x7fffffff) >= 0x7ff00000
        condition = (high_bits & 0x7fffffff) >= 0x7ff00000
        
