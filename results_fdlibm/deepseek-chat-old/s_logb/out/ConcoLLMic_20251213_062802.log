import struct

def check_float_representation(value_str):
    """Check if a string value when converted to double has exponent field 0x7ff"""
    try:
        # Convert string to float
        value = float(value_str)
        
        # Convert to IEEE 754 double-precision bytes
        bytes_repr = struct.pack('>d', value)
        
        # Extract high-order 32 bits (excluding sign bit)
        # For big-endian: first 4 bytes contain sign bit and exponent
        high_32_bits = struct.unpack('>I', bytes_repr[:4])[0]
        
        # Check if exponent field (bits 1-11) is 0x7ff
        # Exponent is bits 1-11 (mask 0x7ff00000 after shifting)
        exponent = (high_32_bits >> 20) & 0x7FF
        
        print(f"Value: {value_str}")
        print(f"Float value: {value}")
        print(f"High 32 bits: 0x{high_32_bits:08x}")
        print(f"Exponent field: 0x{exponent:03x}")
        print(f"Meets condition (>= 0x7ff00000): {high_32_bits >= 0x7ff00000}")
        print(f"Exponent is 0x7ff: {exponent == 0x7ff}")
        print("-" * 40)
        
        return exponent == 0x7ff
        
    except ValueError as e:
        print(f"Error converting '{value_str}': {e}")
        return False

# Test various special floating-point values
test_values = ["inf", "infinity", "-inf", "-infinity", "nan", "NaN", "1.0"]

for value in test_values:
    check_float_representation(value)
