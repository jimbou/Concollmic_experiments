import struct

def get_float_from_exponent(k):
    """Generate a float with specific biased exponent k"""
    # Create the 64-bit representation
    # sign = 0, exponent = k, mantissa = 0
    bits = (k << 52)  # Shift exponent to the correct position
    
    # Convert to float
    packed = struct.pack('>Q', bits)  # Pack as big-endian 64-bit integer
    value = struct.unpack('>d', packed)[0]  # Unpack as double
    
