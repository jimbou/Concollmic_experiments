import struct

def get_float_from_exponent(k):
    """Generate a float with specific biased exponent k"""
    # k is the biased exponent (11 bits, 0-2047)
    # For normalized numbers: 1 <= k <= 2046
    # The actual exponent is k - 1023
    
    # Create a double-precision float with specific exponent
    # IEEE 754 double format: sign (1 bit) | exponent (11 bits) | mantissa (52 bits)
    
    # Let's use a simple mantissa (all zeros except the implicit 1)
    # This gives us the value 1.0 * 2^(k-1023)
    
    # Pack the bits: sign=0, exponent=k, mantissa=0
    if k < 1 or k > 2046:
        raise ValueError("k must be between 1 and 2046 for normalized numbers")
    
    # For double: 64 bits = 1 sign + 11 exponent + 52 mantissa
    # The exponent is stored with bias 1023
    # So to get exponent k, we need to store k
    
    # Create the 64-bit representation
    # sign = 0, exponent = k, mantissa = 0
    bits = (k << 52)  # Shift exponent to the correct position
    
    # Convert to float
    packed = struct.pack('>Q', bits)  # Pack as big-endian 64-bit integer
    value = struct.unpack('>d', packed)[0]  # Unpack as double
    
    return value

