exponent = (inf_bits >> 52) & 0x7FF
mantissa = inf_bits & ((1 << 52) - 1)
print(f"Exponent: {exponent} (0x{exponent:03x})")
print(f"Mantissa: {mantissa} (0x{mantissa:013x})")
print(f"Sign: 0 (positive)")
