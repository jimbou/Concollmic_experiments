    high_bits = get_high_bits(value)
    hex_repr = hex(high_bits)
    satisfies = high_bits >= 0x7ff00000
    print(f"{name} ({value}):")
    print(f"  High bits: {high_bits} ({hex_repr})")
    print(f"  >= 0x7ff00000? {satisfies}")
    print()

# Also check the exact IEEE 754 structure
print("IEEE 754 structure for inf:")
