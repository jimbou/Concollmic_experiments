import struct
import math

# Function to get high-order 32 bits of a double
def get_high_bits(f):
    # Pack double as 8 bytes, then get high 32 bits
    packed = struct.pack('d', f)
    # Convert to integer representation
    int_repr = struct.unpack('Q', packed)[0]
    # Get high 32 bits (bits 32-63)
    high_bits = (int_repr >> 32) & 0xFFFFFFFF
    return high_bits

# Test values
test_values = [
    ("inf", math.inf),
    ("nan", math.nan),
    ("1.0", 1.0),  # For comparison
    ("large", 1.7e308),  # Largest finite double
]

