    packed = struct.pack('d', val)
    # Unpack as 64-bit integer to get the binary representation
    int_repr = struct.unpack('Q', packed)[0]
    
    # Extract high and low 32-bit words
    i0 = (int_repr >> 32) & 0xFFFFFFFF  # High 32 bits
    i1 = int_repr & 0xFFFFFFFF          # Low 32 bits
    
