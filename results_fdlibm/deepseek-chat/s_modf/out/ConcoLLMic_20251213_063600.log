not_integer = z3.Not(z3.fpEQ(x, z3.fpToFP(z3.RNE(), x_floor, z3.Float64())))

# Combine all constraints
final_constraint = z3.And(x_finite, x_positive, lower_bound, upper_bound, not_integer)
