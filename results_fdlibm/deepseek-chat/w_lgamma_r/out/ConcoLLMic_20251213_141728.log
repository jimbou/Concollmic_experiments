# Test negative integers with math.lgamma (Python's implementation)
# Note: math.lgamma is similar to lgamma_r but without the sign parameter
test_values = [-1, -2, -3, -4, -5, 0, 1, 2, 3, 1000, -1000]

print("Testing lgamma behavior:")
for x in test_values:
    try:
        result = math.lgamma(x)
        is_finite_x = math.isfinite(x)
        is_finite_result = math.isfinite(result)
        print(f"x={x:6}, finite(x)={is_finite_x:5}, lgamma(x)={result:15.6f}, finite(lgamma(x))={is_finite_result:5}")
    except (ValueError, OverflowError) as e:
        print(f"x={x:6}, finite(x)={math.isfinite(x):5}, lgamma(x)=ERROR: {e}")
