import struct
import math

# Let me understand the IEEE 754 double-precision format better
# Double precision: 1 sign bit, 11 exponent bits, 52 mantissa bits
# The "high 32 bits" likely means bits 63-32 (the most significant 32 bits)
# "excluding the sign bit" means we ignore bit 63

# Function to get high 32 bits of double (excluding sign bit)
def get_high_32_bits_excluding_sign(x):
    # Convert to IEEE 754 double representation
    packed = struct.pack('>d', x)
    # Get the 64-bit integer representation
    bits = struct.unpack('>Q', packed)[0]
    
    print(f"Full 64-bit representation of {x}: 0x{bits:016X}")
    
    # Extract high 32 bits (bits 63-32)
    high_32 = (bits >> 32) & 0xFFFFFFFF
    print(f"High 32 bits (including sign): 0x{high_32:08X}")
    
    # Exclude sign bit (bit 63) - this means we take bits 62-32
    # So we shift right by 1 to remove the sign bit
    high_32_no_sign = (high_32 >> 1) & 0x7FFFFFFF
    print(f"High 32 bits (excluding sign): 0x{high_32_no_sign:08X}")
    
    return high_32_no_sign

# Target value: 0x3FDA827A
target_bits = 0x3FDA827A
print(f"Target high 32 bits (excluding sign): 0x{target_bits:08X}")

# Test with a value that should be above the threshold
# sqrt(2) - 1 ≈ 0.41421356237309515
