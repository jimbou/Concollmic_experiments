# Let me also test what 0x3FDA827A represents as a double
# Reverse engineer: what double value has high 32 bits (excluding sign) = 0x3FDA827A?
# This means the high 32 bits including sign would be (0x3FDA827A << 1) since we excluded the sign bit
# The sign bit would be 0 for positive numbers
high_32_with_sign = target_bits << 1
print(f"\nHigh 32 bits with sign (assuming positive): 0x{high_32_with_sign:08X}")

# Create a 64-bit value with these high bits and 0 for low bits
full_bits = (high_32_with_sign << 32)
print(f"Full 64-bit representation: 0x{full_bits:016X}")

# Convert back to double
try:
    reconstructed = struct.unpack('>d', struct.pack('>Q', full_bits))[0]
    print(f"Reconstructed value: {reconstructed}")
except:
    print("Could not reconstruct value")
