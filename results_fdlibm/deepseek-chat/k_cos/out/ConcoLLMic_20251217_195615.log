def hex_to_double(hex_val):
    # Convert hex to bytes (assuming little-endian)
    # For __HI() macro, we need to reconstruct the double
    # __HI() gives the high 32 bits, so we need to set low 32 bits to 0
    high_bits = hex_val
    low_bits = 0x00000000
    
    # Combine into 64-bit representation (little-endian)
    combined = (high_bits << 32) | low_bits
    bytes_repr = combined.to_bytes(8, 'big')
    
    # Convert to double
    return struct.unpack('>d', bytes_repr)[0]

# Test the range boundaries
lower_bound_hex = 0x3FD33333
upper_bound_hex = 0x3FE90000

lower_double = hex_to_double(lower_bound_hex)
upper_double = hex_to_double(upper_bound_hex)

