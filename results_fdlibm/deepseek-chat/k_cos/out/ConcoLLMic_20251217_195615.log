import struct

def get_high_bits(dbl_val):
    """Get the high 32 bits of a double value"""
    # Pack the double as bytes (big-endian)
    bytes_repr = struct.pack('>d', dbl_val)
    
    # Convert to integer
    int_repr = int.from_bytes(bytes_repr, 'big')
    
    # Extract high 32 bits
    high_bits = (int_repr >> 32) & 0xFFFFFFFF
    
    # Mask out sign bit
    return high_bits & 0x7FFFFFFF

# Test some values
