import struct

# Function to get high-order bits of a double
def get_high_bits(x):
    # Convert double to 64-bit integer representation
    bits = struct.unpack('>Q', struct.pack('>d', x))[0]
    # Get high-order 32 bits (bits 32-63)
    high_bits = (bits >> 32) & 0xFFFFFFFF
    return high_bits

