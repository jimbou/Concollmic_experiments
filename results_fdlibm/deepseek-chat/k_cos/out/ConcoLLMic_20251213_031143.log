import struct

# Function to get __HI(x) for a double
def get_hi(x):
    # Convert double to 64-bit representation
    bits = struct.unpack('>Q', struct.pack('>d', x))[0]
    # Extract high 32 bits (bits 63-32)
    hi = (bits >> 32) & 0xFFFFFFFF
    return hi

