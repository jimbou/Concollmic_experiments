# Let's verify what 0x41b00000 represents in IEEE 754 double precision
import struct

# 0x41b00000 is the high-order word of a double
# In IEEE 754 double, the high-order word contains the sign bit and exponent
# Let's see what value this corresponds to

# For a double, the high-order word is bits 32-63
# 0x41b00000 in binary: 01000001 10110000 00000000 00000000
# Sign bit: 0 (positive)
# Exponent: 10000011011 (decimal 1051)
# Actual exponent = 1051 - 1023 = 28
# So the value is 2^28 = 268,435,456

# Let's confirm by creating a double with this high-order word
high_word = 0x41b00000
low_word = 0x00000000  # low word can be 0 for the minimum value

# Combine to form a double (little-endian)
double_bytes = struct.pack('<II', low_word, high_word)
value = struct.unpack('d', double_bytes)[0]

print(f"High word: 0x{high_word:08x}")
print(f"Value represented: {value}")
print(f"2^28 = {2**28}")
print(f"Are they equal? {value == 2**28}")

# Now let's test a value slightly above this threshold
test_value = 268435456.1
bytes_rep = struct.pack('d', test_value)
low, high = struct.unpack('<II', bytes_rep)
print(f"\nTest value: {test_value}")
print(f"High word: 0x{high:08x}")
print(f"Is high word >= 0x41b00000? {high >= 0x41b00000}")
