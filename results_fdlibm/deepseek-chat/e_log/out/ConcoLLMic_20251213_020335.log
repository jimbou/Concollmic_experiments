import z3

# We need to find a double value x that satisfies (0x000fffff & (2 + hx)) >= 3
# where hx is the high 32 bits of the IEEE 754 representation of x

# Let's model this as a bit-vector problem
# A double has 64 bits: 1 sign bit, 11 exponent bits, 52 mantissa bits
# hx is the high 32 bits: sign + 11 exponent + 20 high mantissa bits

# Create a 64-bit vector for the double
x_bits = z3.BitVec('x_bits', 64)

# Extract hx (high 32 bits)
hx = z3.Extract(63, 32, x_bits)

# The constraint: (0x000fffff & (2 + hx)) >= 3
# 0x000fffff is a mask for the lower 20 bits
mask = 0x000fffff

# Create the constraint
constraint = z3.And(
    # x must be positive (sign bit = 0)
    z3.Extract(63, 63, x_bits) == 0,
    
    # x must be finite (exponent not all 1s)
    z3.Extract(62, 52, x_bits) != 0x7FF,
    
    # x must not be zero (exponent and mantissa not all 0s)
    z3.Or(z3.Extract(62, 52, x_bits) != 0, z3.Extract(51, 0, x_bits) != 0),
    
    # The main constraint: (mask & (2 + hx)) >= 3
    (z3.BVAnd(mask, hx + 2)) >= 3
)

# Solve the constraint
solver = z3.Solver()
solver.add(constraint)

if solver.check() == z3.sat:
    model = solver.model()
    x_val = model[x_bits].as_long()
    # Convert bits back to double
    import struct
    packed = struct.pack('Q', x_val)
    x_double = struct.unpack('d', packed)[0]
    
    # Verify the constraint
    hx_actual = (x_val >> 32) & 0xFFFFFFFF
    result = (mask & (2 + hx_actual))
    
    print(f"Found solution: x = {x_double}")
    print(f"x_bits = {x_val:#x}")
    print(f"hx = {hx_actual:#x}")
    print(f"(2 + hx) = {2 + hx_actual:#x}")
    print(f"(mask & (2 + hx)) = {result:#x} = {result}")
    print(f"Constraint satisfied: {result >= 3}")
else:
    print("No solution found")
