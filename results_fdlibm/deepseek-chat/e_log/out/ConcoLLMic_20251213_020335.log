import struct

# Let's define a function to extract hx from a double
# hx is the high 32 bits of the IEEE 754 representation

def double_to_hx_lx(x):
    # Convert double to 64-bit integer representation
    packed = struct.pack('d', x)
    # Convert to unsigned long long (64 bits)
    bits = struct.unpack('Q', packed)[0]
    # hx is the high 32 bits
    hx = (bits >> 32) & 0xFFFFFFFF
    # lx is the low 32 bits
    lx = bits & 0xFFFFFFFF
    return hx, lx

