import struct

# Check the IEEE 754 representation of 1.0
def get_ieee754_high_word(value):
    # Convert double to 64-bit representation
    packed = struct.pack('d', value)
    # Convert to integer representation
    int_repr = struct.unpack('Q', packed)[0]
    # Get high word (bits 32-63)
    high_word = (int_repr >> 32) & 0xFFFFFFFF
    # Clear sign bit (bit 31)
    high_word_cleared = high_word & 0x7FFFFFFF
    return high_word, high_word_cleared

# Test with 1.0
value = 1.0
high_word, high_word_cleared = get_ieee754_high_word(value)

