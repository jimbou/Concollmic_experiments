import struct

# Test if 1.0 satisfies the IEEE 754 constraints
def check_float_constraints(value):
    # Convert to IEEE 754 double (64-bit)
    packed = struct.pack('>d', value)
    # Get high 32 bits
    high_bits = struct.unpack('>I', packed[:4])[0]
    # Mask with 0x7fffffff
    masked = high_bits & 0x7fffffff
    
    print(f"Value: {value}")
