    print(f"< 0x7ff00000: {masked < 0x7ff00000}")
    print(f"Satisfies constraints: {masked >= 0x00100000 and masked < 0x7ff00000}")
    return masked >= 0x00100000 and masked < 0x7ff00000

# Test 1.0
