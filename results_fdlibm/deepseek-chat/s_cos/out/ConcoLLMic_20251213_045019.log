import math

# Simulate what __ieee754_rem_pio2 might do
# It reduces x modulo π/2 and returns the quotient and remainder

def simulate_rem_pio2(x):
    """Simulate the behavior of __ieee754_rem_pio2"""
    # π/2
    pio2 = math.pi / 2
    
    # Calculate how many π/2 intervals fit into x
    n = int(x / pio2)
    
    # Calculate the remainder
    remainder = x - n * pio2
    
    return n, remainder

