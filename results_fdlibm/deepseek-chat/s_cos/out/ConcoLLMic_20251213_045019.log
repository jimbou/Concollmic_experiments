import math

# Test the __ieee754_rem_pio2 equivalent in Python
# We'll use math.fmod to simulate the remainder operation

def test_quadrant(x):
    # π/2
    pio2 = math.pi / 2
    
    # Reduce x modulo π/2
    remainder = math.fmod(x, pio2)
    
    # Determine quadrant based on the integer part of x/(π/2)
    k = int(x / pio2)
    n = k % 4
    
    return n, remainder

