import struct
import math

def get_ieee754_representation(x):
    """Get the IEEE 754 double-precision representation of x"""
    # Pack as double, then unpack as unsigned long long
    packed = struct.pack('d', x)
    # Convert to integer representation
    int_repr = struct.unpack('Q', packed)[0]
    
    # Extract high and low parts (assuming little-endian)
    # For IEEE 754 double: 1 sign bit, 11 exponent bits, 52 mantissa bits
    sign = (int_repr >> 63) & 0x1
    exponent = (int_repr >> 52) & 0x7FF
    mantissa = int_repr & 0xFFFFFFFFFFFFF
    
    # Get ix = __HI(x) & 0x7fffffff (clear sign bit)
    # In IEEE 754, the high word contains sign and exponent
    # For our purposes, we can use the integer representation without sign
    ix = int_repr & 0x7FFFFFFFFFFFFFFF
    
    return int_repr, sign, exponent, mantissa, ix

# Test values
x = math.pi  # π
int_repr, sign, exponent, mantissa, ix = get_ieee754_representation(x)

