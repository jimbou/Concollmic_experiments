import subprocess
import ctypes

# Test different string representations that might be recognized as NaN by atof()
test_strings = [
    "nan",
    "NaN", 
    "NAN",
    "-nan",
    "inf",
    "-inf",
    "1.0/0.0",
    "0.0/0.0",
    "sqrt(-1)",
    "1e1000",  # Overflow to infinity
    "-1e1000", # Negative overflow
]

# Create a simple C program to test atof() behavior
c_code = '''
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <number>\\n", argv[0]);
        return 1;
    }
    
    double value = atof(argv[1]);
    
    printf("Input: %s\\n", argv[1]);
    printf("Parsed value: %f\\n", value);
    printf("Is NaN: %d\\n", isnan(value));
    printf("Is Inf: %d\\n", isinf(value));
    
    return 0;
}
'''

# Write and compile the test program
with open('test_atof.c', 'w') as f:
    f.write(c_code)

# Compile the test program
compile_result = subprocess.run(['gcc', 'test_atof.c', '-o', 'test_atof', '-lm'], capture_output=True)
if compile_result.returncode != 0:
    print("Compilation failed:", compile_result.stderr.decode())
else:
    print("Testing atof() behavior with different strings:")
    for test_str in test_strings:
        result = subprocess.run(['./test_atof', test_str], capture_output=True, text=True)
        print(f"\nTesting '{test_str}':")
