import struct

# Let me check the actual IEEE 754 representation of these values

def analyze_float(x):
    # Convert double to IEEE 754 representation
    packed = struct.pack('d', x)
    
    # Check both endianness possibilities
    # Little-endian: lower bytes first
    le_high = struct.unpack('<I', packed[4:])[0]  # Last 4 bytes
    le_low = struct.unpack('<I', packed[:4])[0]   # First 4 bytes
    
    # Big-endian: higher bytes first  
    be_high = struct.unpack('>I', packed[:4])[0]  # First 4 bytes
    be_low = struct.unpack('>I', packed[4:])[0]   # Last 4 bytes
    
    # For IEEE 754 double, the sign, exponent, and part of mantissa are in the high word
    # Let's check which ordering gives us meaningful values
    
    return le_high, le_low, be_high, be_low, packed.hex()

# Test values
test_values = [0.5, 1.0, 2.0, 1.1]

