import struct

def check_condition_correct(x):
    # Convert double to IEEE 754 representation
    packed = struct.pack('d', x)
    
    # In little-endian systems, the high word is the last 4 bytes
    # This contains the sign, exponent, and high part of mantissa
    high_word = struct.unpack('<I', packed[4:])[0]  # Last 4 bytes
    
    # Mask out sign bit (bit 31)
    ix = high_word & 0x7fffffff
    
    return ix >= 0x3ff00000, ix, high_word

# Test values
test_values = [0.5, 0.9999999999, 1.0, 1.0000000001, 1.1, 2.0, 3.0]

