import struct

def get_high_word_correct(d):
    # Convert double to 64-bit representation
    bits = struct.pack('d', d)
    
    # Convert to integer representation
    int_repr = struct.unpack('Q', bits)[0]
    
    # High word is the most significant 32 bits
    high_word = (int_repr >> 32) & 0xFFFFFFFF
    
    # Exclude the sign bit (bit 63 of the double, which is bit 31 of the high word)
    return high_word & 0x7FFFFFFF

