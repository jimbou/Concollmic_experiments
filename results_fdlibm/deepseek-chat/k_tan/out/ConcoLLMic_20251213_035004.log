import struct

# Function to convert double to its high word representation
def double_to_high_word(d):
    # Convert double to 64-bit representation
    packed = struct.pack('d', d)
    # Convert to integer (little-endian)
    value = struct.unpack('<Q', packed)[0]
    # Extract high 32 bits
    hx = (value >> 32) & 0xFFFFFFFF
    return hx

