def ieee754_to_float(hex_val):
    """Convert IEEE 754 hexadecimal representation to float"""
    import struct
    # Convert hex to bytes
    hex_bytes = hex_val.to_bytes(4, byteorder='big')
    # Convert to float
    return struct.unpack('>f', hex_bytes)[0]

