def float_to_ieee754_hex(f):
    """Convert float to IEEE 754 hexadecimal representation"""
    import struct
    # Convert float to bytes
    float_bytes = struct.pack('>f', f)
    # Convert to hex
    return hex(int.from_bytes(float_bytes, byteorder='big'))

