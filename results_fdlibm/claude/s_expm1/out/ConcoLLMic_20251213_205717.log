import struct
import binascii

def float_to_hex(f):
    # Convert float to its IEEE 754 hex representation
    b = struct.pack('>d', f)
    i = struct.unpack('>q', b)[0]
    h = hex(i)
    return h

def get_high_32_bits(f):
    # Get the high 32 bits of a double-precision float
    b = struct.pack('>d', f)
    high_32 = struct.unpack('>I', b[0:4])[0]
    return hex(high_32)

# Check lower bound (~0.36)
