import struct

# Function to check if a floating point value has exponent bits all set to 1
def check_exponent_all_ones(value):
    # Convert float to its IEEE 754 binary representation
    binary = struct.unpack('Q', struct.pack('d', value))[0]
    
    # Extract the exponent bits (bits 52-62)
    exponent = (binary >> 52) & 0x7FF
    
    # Check if all exponent bits are 1
    return exponent == 0x7FF, hex((binary >> 32) & 0xFFFFFFFF)

# Test various values
test_values = [
    float('inf'),
    float('-inf'),
    float('nan'),
    1e309,  # Beyond max double value
    1.0,    # Regular value for comparison
]

for value in test_values:
    is_special, hex_upper = check_exponent_all_ones(value)
    print(f"Value: {value}, Has all exponent bits set: {is_special}, Upper 32 bits: {hex_upper}")
    print(f"Satisfies hx >= 0x7ff00000: {int(hex_upper, 16) >= 0x7ff00000}")
