import struct

# Function to convert a float to its hex representation
def float_to_hex(f):
    # Pack the float into bytes and convert to hex
    packed = struct.pack('>d', f)  # big-endian double
    hex_val = '0x' + ''.join(f'{b:02x}' for b in packed)
    
    # Extract the high 32 bits and mask the sign bit
    high_32_bits = (struct.unpack('>Q', packed)[0] >> 32) & 0x7fffffff
    return hex_val, f'0x{high_32_bits:08x}'

