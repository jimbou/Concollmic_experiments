# Let's verify that our chosen value 300,000,000 (3e8) would satisfy the constraints
# by checking its IEEE 754 representation

import struct

def float_to_hex(f):
    # Convert float to its IEEE 754 hex representation
    b = struct.pack('>d', f)  # big-endian double-precision float
    i = struct.unpack('>Q', b)[0]  # interpret as unsigned 64-bit integer
    return hex(i)

def get_high_bits(f):
    # Extract the high 32 bits of a double value
    b = struct.pack('>d', f)  # big-endian double-precision float
    high_bits = struct.unpack('>I', b[0:4])[0]  # first 4 bytes as unsigned int
    return high_bits

def check_constraint(f):
    high_bits = get_high_bits(f)
    ix = high_bits & 0x7fffffff  # Mask off sign bit
    
