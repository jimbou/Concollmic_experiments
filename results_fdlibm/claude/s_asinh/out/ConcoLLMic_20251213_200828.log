    print(f"IEEE 754 hex: {float_to_hex(f)}")
    print(f"High bits: {hex(high_bits)}")
    print(f"ix = high_bits & 0x7fffffff: {hex(ix)}")
    print(f"0x41b00000: {hex(0x41b00000)}")
    print(f"0x7ff00000: {hex(0x7ff00000)}")
    print(f"Constraint ix > 0x41b00000: {ix > 0x41b00000}")
    print(f"Constraint ix < 0x7ff00000: {ix < 0x7ff00000}")
    print(f"Both constraints satisfied: {(ix > 0x41b00000) and (ix < 0x7ff00000)}")

# Check our chosen value
