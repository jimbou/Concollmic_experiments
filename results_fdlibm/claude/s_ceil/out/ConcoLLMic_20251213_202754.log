import struct

def analyze_double(value):
    # Convert double to its binary representation
    binary = struct.pack('>d', value)
    # Extract high and low 32-bit words
    i0 = (binary[0] << 24) | (binary[1] << 16) | (binary[2] << 8) | binary[3]
    i1 = (binary[4] << 24) | (binary[5] << 16) | (binary[6] << 8) | binary[7]
    
    # Extract exponent bits
    exp_bits = (i0 >> 20) & 0x7ff
    # Calculate j0
    j0 = exp_bits - 0x3ff
    
    # Check if it's not an integer
    fraction_mask_i0 = 0xFFFFF  # Lower 20 bits of i0
    is_not_integer = (i0 & fraction_mask_i0) != 0 or i1 != 0
    
    return {
        "value": value,
        "i0": hex(i0),
        "i1": hex(i1),
        "exp_bits": hex(exp_bits),
        "j0": j0,
        "is_not_integer": is_not_integer,
        "satisfies_j0_constraint": 0 <= j0 < 20,
        "satisfies_all_constraints": (0 <= j0 < 20) and is_not_integer
    }

# Test values around the boundary
