import struct

def double_to_hex(d):
    """Convert a double to its hexadecimal representation"""
    packed = struct.pack('>d', d)  # big-endian double
    high_word = struct.unpack('>I', packed[:4])[0]  # high 32 bits
    low_word = struct.unpack('>I', packed[4:])[0]   # low 32 bits
    return high_word, low_word

def hex_to_double(high, low):
    """Convert hexadecimal representation to double"""
    packed = struct.pack('>II', high, low)
    return struct.unpack('>d', packed)[0]

# Our constraints: high word (after masking sign bit) must be between 0x3FD33333 and 0x3fe90000
