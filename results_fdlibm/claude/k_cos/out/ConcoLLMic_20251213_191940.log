import struct

def float_to_hex(f):
    # Convert float to its IEEE 754 representation
    b = struct.pack('>d', f)
    # Extract high word (first 4 bytes)
    high_word = int.from_bytes(b[:4], byteorder='big')
    # Mask with 0x7fffffff to remove sign bit
    masked = high_word & 0x7fffffff
    return f"Value: {f}, High word: 0x{high_word:08x}, Masked: 0x{masked:08x}"

# Test various values
