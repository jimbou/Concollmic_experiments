import struct
import math

def float_to_hex(f):
    # Convert float to its hexadecimal representation
    b = struct.pack('>d', f)  # big-endian double-precision float
    high_word = b[0:4].hex()  # first 4 bytes (high word)
    low_word = b[4:8].hex()   # last 4 bytes (low word)
    return high_word, low_word

# Test with infinity and NaN
print("Positive infinity:")
high, low = float_to_hex(float('inf'))
print(f"High word: 0x{high}, Low word: 0x{low}")
print(f"Is high word >= 0x7ff00000? {int(high, 16) >= 0x7ff00000}")

print("\nNegative infinity:")
high, low = float_to_hex(float('-inf'))
print(f"High word: 0x{high}, Low word: 0x{low}")
print(f"Is high word >= 0x7ff00000? {int(high, 16) >= 0x7ff00000}")

print("\nNaN:")
high, low = float_to_hex(float('nan'))
print(f"High word: 0x{high}, Low word: 0x{low}")
print(f"Is high word >= 0x7ff00000? {int(high, 16) >= 0x7ff00000}")

print("\nRegular value (1.0):")
high, low = float_to_hex(1.0)
print(f"High word: 0x{high}, Low word: 0x{low}")
print(f"Is high word >= 0x7ff00000? {int(high, 16) >= 0x7ff00000}")
