import struct

# Function to display IEEE 754 representation of a double
def display_ieee754(num):
    # Convert double to its IEEE 754 binary representation
    binary = struct.pack('>d', num)
    # Convert binary to hexadecimal
    hex_repr = ''.join(f'{byte:02x}' for byte in binary)
    # Get the high word (first 4 bytes) and low word (last 4 bytes)
    high_word = int(hex_repr[:8], 16)
    low_word = int(hex_repr[8:], 16)
    
    # Check if high word is negative (in two's complement)
    is_high_word_negative = (high_word & 0x80000000) != 0
    
    print(f"Number: {num}")
    print(f"IEEE 754 hex: 0x{hex_repr}")
    print(f"High word: 0x{high_word:08x} (negative: {is_high_word_negative})")
    print(f"Low word: 0x{low_word:08x}")
    print(f"Sign bit: {1 if num < 0 else 0}")
    print(f"Exponent bits: 0x{(high_word >> 20) & 0x7ff:03x}")
    
    return high_word

# Test with a small negative number
display_ieee754(-1e-300)
print("\n")
