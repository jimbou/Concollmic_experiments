import struct
import math

def float_to_hex(f):
    """Convert a float to its IEEE 754 hex representation"""
    return hex(struct.unpack('<I', struct.pack('<f', f))[0])

def get_high_word(d):
    """Extract the high-order word from a double"""
    # For a double, we need to extract the high 32 bits
    bits = struct.unpack('>Q', struct.pack('>d', d))[0]
    high_word = (bits >> 32) & 0xFFFFFFFF
    return high_word

