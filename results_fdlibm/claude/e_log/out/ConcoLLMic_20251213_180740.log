import struct

def get_ieee754_bits(value):
    # Convert float to its IEEE 754 representation
    packed = struct.pack('>d', value)
    # Convert to 64-bit integer
    bits = int.from_bytes(packed, 'big')
    # Extract high 32 bits
    hx = bits >> 32
    # Calculate the constraint expression
    constraint_result = 0x000fffff & (2 + hx)
    return {
        'value': value,
        'ieee754_hex': hex(bits),
        'hx': hex(hx),
        '2+hx': hex(2 + hx),
        'constraint_result': constraint_result,
