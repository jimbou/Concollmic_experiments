    bits = get_ieee754_bits(value)
    abs_bits = bits & 0x7fffffff_ffffffff  # Mask to get absolute value (clear sign bit)
    # Extract the upper 32 bits (where our constraint is focused)
    upper_bits = abs_bits >> 32
    return lower_bound_hex < upper_bits < upper_bound_hex

