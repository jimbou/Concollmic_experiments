upper_bound_hex = 0x7ff00000

# Function to get the IEEE 754 representation of a double
def get_ieee754_bits(value):
    # Pack the double into 8 bytes, then unpack as a 64-bit integer
    packed = struct.pack('>d', value)
    bits = int.from_bytes(packed, byteorder='big')
    return bits

# Function to check if a value satisfies our constraint
