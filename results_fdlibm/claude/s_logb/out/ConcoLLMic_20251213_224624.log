import struct

def analyze_double(value):
    # Convert double to its bit representation
    bits = struct.unpack('Q', struct.pack('d', value))[0]
    
    # Extract components
    sign = (bits >> 63) & 1
    exponent = (bits >> 52) & 0x7FF
    fraction = bits & 0xFFFFFFFFFFFFF
    
    # High word (most significant 32 bits)
    ix = bits >> 32
    # Low word (least significant 32 bits)
    lx = bits & 0xFFFFFFFF
    
