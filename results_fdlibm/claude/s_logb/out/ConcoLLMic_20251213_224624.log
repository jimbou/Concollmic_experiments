import struct

# Let's verify the bit patterns for different special values

# Function to display the IEEE 754 bit representation of a float
def show_ieee754(f):
    # Convert float to its IEEE 754 binary representation
    b = struct.pack('>d', f)
    # Convert to hex for easier reading
    hex_repr = ''.join(f'{byte:02x}' for byte in b)
    # Extract high 32 bits (first 8 hex digits)
    high_bits = hex_repr[:8]
    return f"Value: {f}, IEEE 754 hex: {hex_repr}, High 32 bits: 0x{high_bits}"

# Check various special values
print(show_ieee754(float('inf')))
print(show_ieee754(float('-inf')))
print(show_ieee754(float('nan')))
print(show_ieee754(1.8e308))  # Should overflow to inf
print(show_ieee754(1.0))      # For comparison with original input

# Check if these values satisfy our constraint
def check_constraint(f):
    b = struct.pack('>d', f)
    # Extract first 4 bytes (high 32 bits)
    high_bits = int.from_bytes(b[:4], byteorder='big')
    # Apply mask 0x7fffffff (to ignore sign bit)
    masked = high_bits & 0x7fffffff
    return f"Value: {f}, High bits (masked): 0x{masked:08x}, Satisfies ix>=0x7ff00000: {masked >= 0x7ff00000}"

