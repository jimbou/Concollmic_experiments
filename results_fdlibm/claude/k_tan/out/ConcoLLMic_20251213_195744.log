# Let's verify the IEEE 754 representation of 1.0
import struct

def double_to_hex(d):
    # Convert double to its hex representation
    packed = struct.pack('>d', d)
    return '0x' + ''.join(f'{b:02x}' for b in packed)

def get_high_32_bits(d):
    # Get the high 32 bits of a double
    packed = struct.pack('>d', d)
    high_bits = (packed[0] << 24) | (packed[1] << 16) | (packed[2] << 8) | packed[3]
    return high_bits

def check_constraint(d):
