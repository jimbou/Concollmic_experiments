import subprocess
import os
import tempfile

# Create a small C library to override _LIB_VERSION
lib_code = """
#include <math.h>

/* Override _LIB_VERSION to a non-IEEE value */
#ifdef _IEEE_
#undef _IEEE_
#endif

#ifdef _LIB_VERSION
#undef _LIB_VERSION
#endif

/* Try different values: _SVID_, _XOPEN_, _POSIX_ */
const enum version _LIB_VERSION = _SVID_;
"""

try:
    # Write the code to a temporary file
    with tempfile.NamedTemporaryFile(suffix='.c', delete=False) as f:
        f.write(lib_code.encode())
        lib_file = f.name

    print(f"Created temporary file: {lib_file}")
    
    # Try to compile the library
    compile_cmd = f"gcc -shared -fPIC {lib_file} -o liboverride.so"
    print(f"Compiling with: {compile_cmd}")
    
    compile_result = subprocess.run(
        compile_cmd,
        shell=True,
        capture_output=True,
        encoding="utf-8"
    )
    
    print(f"Compile stdout: {compile_result.stdout}")
    print(f"Compile stderr: {compile_result.stderr}")
    
    if compile_result.returncode != 0:
        print("Compilation failed")
    else:
        print("Compilation succeeded")
        
        # Try running with the preloaded library
        env = os.environ.copy()
        env["LD_PRELOAD"] = f"{os.getcwd()}/liboverride.so"
        
        run_result = subprocess.run(
            ["./temp_executable NaN 0.0"],
            env=env,
            shell=True,
            capture_output=True,
            encoding="utf-8"
        )
        
        print(f"Run return code: {run_result.returncode}")
        print(f"Run stdout: {run_result.stdout}")
        print(f"Run stderr: {run_result.stderr}")
        
except Exception as e:
    print(f"Exception: {e}")
finally:
    # Clean up
    try:
        os.unlink(lib_file)
        if os.path.exists("liboverride.so"):
            os.unlink("liboverride.so")
    except:
        pass
