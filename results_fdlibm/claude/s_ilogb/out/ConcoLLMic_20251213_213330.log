import struct

# Convert 1.0 to IEEE 754 representation
def float_to_hex(f):
    # Convert float to its IEEE 754 binary representation
    b = struct.pack('>d', f)
    # Convert binary to hex
    hex_repr = ''.join(f'{byte:02x}' for byte in b)
    return hex_repr

# Get the high word (first 32 bits) of the double
def get_high_word(f):
    b = struct.pack('>d', f)
    high_word = (b[0] << 24) | (b[1] << 16) | (b[2] << 8) | b[3]
    return high_word

# Test with 1.0
value = 1.0
hex_repr = float_to_hex(value)
high_word = get_high_word(value)

print(f"Value: {value}")
print(f"IEEE 754 hex representation: 0x{hex_repr}")
print(f"High word (hx): 0x{high_word:08x}")

# Check if it satisfies our constraints
if 0x00100000 <= high_word < 0x7ff00000:
    print("This value satisfies our constraints!")
else:
    print("This value does NOT satisfy our constraints.")
    
# Let's also check a few other values
