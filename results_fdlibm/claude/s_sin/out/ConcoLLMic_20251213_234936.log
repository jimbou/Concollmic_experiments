# Function to get the high-order word of a double (with sign bit masked off)
def get_high_word(value):
    # Convert double to its IEEE-754 representation
    bits = struct.unpack('>Q', struct.pack('>d', value))[0]
    # Extract high-order word (bits 32-63) and mask off sign bit
