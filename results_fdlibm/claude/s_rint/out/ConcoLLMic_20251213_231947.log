def double_to_hex(d):
    # Pack double to 8 bytes and convert to hex
    packed = struct.pack('>d', d)
    hex_repr = ''.join(f'{b:02x}' for b in packed)
    
    # Extract components
    sign_bit = (packed[0] & 0x80) >> 7
    exponent = ((packed[0] & 0x7F) << 4) | ((packed[1] & 0xF0) >> 4)
    
