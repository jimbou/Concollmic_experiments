import struct

def double_to_hex(d):
    # Convert double to its IEEE 754 hex representation
    packed = struct.pack('>d', d)
    return '0x' + ''.join(f'{b:02x}' for b in packed)

def get_high_word(d):
    # Get the high word (first 4 bytes) of the IEEE 754 representation
    packed = struct.pack('>d', d)
    high_word = (packed[0] << 24) | (packed[1] << 16) | (packed[2] << 8) | packed[3]
    return high_word

def check_constraints(d):
    high_word = get_high_word(d)
    ix = high_word & 0x7fffffff  # Mask out sign bit
    
    print(f"Value: {d}")
    print(f"IEEE 754 hex: {double_to_hex(d)}")
    print(f"High word: 0x{high_word:08x}")
    print(f"ix (high word with sign bit masked): 0x{ix:08x}")
    
    # Check constraints
    print(f"Is ix > 0x3fe921fb? {ix > 0x3fe921fb}")
    print(f"Is ix < 0x4002d97c? {ix < 0x4002d97c}")
    print(f"Are all constraints satisfied? {ix > 0x3fe921fb and ix < 0x4002d97c}")

# Check our chosen value
check_constraints(2.0)

# Also check the lower bound (π/2)
import math
check_constraints(math.pi/2)

# And check a value slightly below the upper bound
check_constraints(2.4)
