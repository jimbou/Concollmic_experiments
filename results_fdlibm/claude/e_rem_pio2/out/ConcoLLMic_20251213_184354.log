import struct

def double_to_hex(d):
    # Convert double to its IEEE-754 hex representation
    packed = struct.pack('>d', d)
    high_bits = struct.unpack('>I', packed[0:4])[0]  # Get high 32 bits
    low_bits = struct.unpack('>I', packed[4:8])[0]   # Get low 32 bits
    
    # Mask off sign bit to get ix value
    ix = high_bits & 0x7fffffff
    
    print(f"Value: {d}")
    print(f"Full hex: 0x{high_bits:08x}{low_bits:08x}")
    print(f"High 32 bits: 0x{high_bits:08x}")
    print(f"High 32 bits with sign bit masked (ix): 0x{ix:08x}")
    
    # Check if it satisfies our constraints
