import struct

# Function to examine the bit representation of a double
def examine_double(value):
    # Pack the double into bytes
    packed = struct.pack('>d', value)
    # Unpack as two 32-bit integers (high and low words)
    high, low = struct.unpack('>II', packed)
    
    print(f"Value: {value}")
    print(f"High word: 0x{high:08x}")
    print(f"Low word: 0x{low:08x}")
