import os
import subprocess

# Create a simple temp_executable that just calls exp
c_program = """
#include <stdio.h>
#include <math.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
    if (argc != 2) {
        fprintf(stderr, "Usage: %s <number>\\n", argv[0]);
        return 1;
    }
    
    double x = atof(argv[1]);
    fprintf(stderr, "Input: %f\\n", x);
    
    // Call exp function
    double result = exp(x);
    
    fprintf(stderr, "Result: %f\\n", result);
    
    return 0;
}
"""

# Write the C program to a file
with open("temp_executable.c", "w") as f:
    f.write(c_program)

# Compile it
try:
    subprocess.run(["gcc", "temp_executable.c", "-o", "temp_executable", "-lm"], check=True)
    print("Successfully compiled temp_executable")
    
    # Run it normally
    result = subprocess.run(["./temp_executable", "1.0"], 
                            capture_output=True, 
                            text=True)
    print(f"STDERR (normal run): {result.stderr}")
    
except Exception as e:
    print(f"Failed to compile or run: {e}")

# Now create a shared library that will intercept the exp function
c_program2 = """
#define _GNU_SOURCE
#include <stdio.h>
#include <math.h>
#include <stdlib.h>
#include <dlfcn.h>

// Function pointer type for the original exp function
typedef double (*orig_exp_t)(double);

// Our custom implementation of exp
double exp(double x) {
    // Get the original exp function
    orig_exp_t orig_exp = (orig_exp_t)dlsym(RTLD_NEXT, "exp");
    
    // Print information about the call
    fprintf(stderr, "[Custom exp] Called with x = %f\\n", x);
    
    // Call the original function
    double result = orig_exp(x);
    
    // Print the result
    fprintf(stderr, "[Custom exp] Result = %f\\n", result);
    
    // Print information about the _LIB_VERSION branch
    fprintf(stderr, "[Custom exp] Simulating _LIB_VERSION != _IEEE_ branch\\n");
    
    // Return the result
    return result;
}

// This function will be called when the library is loaded
void __attribute__((constructor)) init(void) {
    fprintf(stderr, "[Custom Math Library] Initialized\\n");
    fprintf(stderr, "[Custom Math Library] Simulating _LIB_VERSION != _IEEE_\\n");
}
"""

# Write the C program to a file
with open("custom_math.c", "w") as f:
    f.write(c_program2)

# Try to compile as a shared library
