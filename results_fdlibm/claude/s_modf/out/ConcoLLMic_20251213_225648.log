# Let's also examine the IEEE-754 representation to confirm j0 calculation
import struct

def get_j0(x):
    # Convert float to its IEEE 754 representation
    binary = struct.pack('>d', x)
    # Extract high 32 bits (i0)
    i0 = struct.unpack('>I', binary[:4])[0]
    # Calculate j0 as per the constraint
    j0 = ((i0 >> 20) & 0x7ff) - 0x3ff
    return j0, i0

