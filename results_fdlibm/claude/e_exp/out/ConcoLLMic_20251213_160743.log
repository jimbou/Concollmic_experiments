    # Pack the float as a 64-bit double
    packed = struct.pack('>d', value)
    # Convert to hex
    hex_repr = ''.join(f'{b:02x}' for b in packed)
    # Split into upper and lower 32 bits
    upper_32 = hex_repr[:8]
