import struct

# Convert float to its IEEE-754 representation
def float_to_hex(f):
    # Convert float to its IEEE 754 binary representation
    b = struct.pack('>d', f)
    # Convert to hexadecimal
    h = '0x' + ''.join(f'{x:02x}' for x in b)
    return h

# Convert float to high bits (first 32 bits)
def float_to_high_bits(f):
    b = struct.pack('>d', f)
    # Get first 4 bytes (high bits)
    high_bits = b[:4]
    return '0x' + ''.join(f'{x:02x}' for x in high_bits)

# Check if 1.5 meets our constraints
