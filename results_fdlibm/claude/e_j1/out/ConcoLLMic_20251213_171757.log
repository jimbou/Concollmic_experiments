import struct

def float_to_hex(f):
    # Convert float to its hex representation
    b = struct.pack('>d', f)
    i = struct.unpack('>Q', b)[0]
    high_word = (i >> 32) & 0xFFFFFFFF
    low_word = i & 0xFFFFFFFF
    return high_word, low_word

# Test with infinity
