#include <stdio.h>
#include <math.h>

int main(int argc, char *argv[]) {
    if (argc != 3) {
        printf("Need exactly 2 arguments\\n");
        return 1;
    }
    
    double x = atof(argv[1]);
    double fn = atof(argv[2]);
    
    printf("x = %f\\n", x);
    printf("fn = %f\\n", fn);
    printf("isfinite(fn) = %d\\n", isfinite(fn));
    printf("isinf(fn) = %d\\n", isinf(fn));
    printf("isnan(fn) = %d\\n", isnan(fn));
    
    if (!isfinite(fn)) {
        printf("Target branch reached: fn is not finite!\\n");
    }
    
    return 0;
}
"""

