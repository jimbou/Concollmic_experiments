# Let's create a more comprehensive test program

import subprocess
import os
import tempfile

# Create a C program to test different ways of handling non-finite values
c_code = """
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <float.h>

int main(int argc, char *argv[]) {
    if (argc != 3) {
        printf("Need exactly 2 arguments\\n");
        return 1;
    }
    
    double x = atof(argv[1]);
    
    // Try different parsing methods for the second argument
    double fn_atof = atof(argv[2]);
    double fn_strtod;
    char *endptr;
    fn_strtod = strtod(argv[2], &endptr);
    
    printf("Using atof:\\n");
    printf("fn = %g\\n", fn_atof);
    printf("isfinite(fn) = %d\\n", isfinite(fn_atof));
    printf("isinf(fn) = %d\\n", isinf(fn_atof));
    printf("isnan(fn) = %d\\n", isnan(fn_atof));
    
    printf("\\nUsing strtod:\\n");
    printf("fn = %g\\n", fn_strtod);
    printf("isfinite(fn) = %d\\n", isfinite(fn_strtod));
    printf("isinf(fn) = %d\\n", isinf(fn_strtod));
    printf("isnan(fn) = %d\\n", isnan(fn_strtod));
    
    // Try some numeric tricks to generate non-finite values
    double inf_pos = 1.0/0.0;
    double inf_neg = -1.0/0.0;
    double nan_val = sqrt(-1.0);
    
    printf("\\nNumeric tricks:\\n");
    printf("1.0/0.0 = %g, isfinite = %d, isinf = %d\\n", 
           inf_pos, isfinite(inf_pos), isinf(inf_pos));
    printf("-1.0/0.0 = %g, isfinite = %d, isinf = %d\\n", 
           inf_neg, isfinite(inf_neg), isinf(inf_neg));
    printf("sqrt(-1.0) = %g, isfinite = %d, isnan = %d\\n", 
           nan_val, isfinite(nan_val), isnan(nan_val));
    
    // Check if the input string matches specific patterns
    if (strcmp(argv[2], "inf") == 0 || 
        strcmp(argv[2], "+inf") == 0 || 
        strcmp(argv[2], "infinity") == 0 || 
        strcmp(argv[2], "+infinity") == 0) {
        printf("\\nString matches positive infinity pattern\\n");
    }
    
    if (strcmp(argv[2], "-inf") == 0 || 
        strcmp(argv[2], "-infinity") == 0) {
        printf("\\nString matches negative infinity pattern\\n");
    }
    
    if (strcmp(argv[2], "nan") == 0 || 
        strcmp(argv[2], "NaN") == 0) {
        printf("\\nString matches NaN pattern\\n");
    }
    
    return 0;
}
"""

# Write the C code to a temporary file
with tempfile.NamedTemporaryFile(suffix='.c', delete=False) as f:
    f.write(c_code.encode())
    c_filename = f.name

# Compile the C program
executable = c_filename[:-2]  # Remove .c extension
compile_cmd = f"gcc {c_filename} -o {executable} -lm"
subprocess.run(compile_cmd, shell=True)

# Test with different inputs
test_cases = [
    ["1.0", "1.0"],
    ["1.0", "inf"],
    ["1.0", "-inf"],
    ["1.0", "infinity"],
    ["1.0", "-infinity"],
    ["1.0", "nan"],
    ["1.0", "NaN"],
    ["1.0", "1.0e+9999"],  # Very large number that might overflow to inf
    ["1.0", "1.0e-9999"]   # Very small number that might underflow
]

results = []
for args in test_cases:
    cmd = [executable] + args
    result = subprocess.run(cmd, capture_output=True, text=True)
    results.append(f"Command: {' '.join(cmd)}\nOutput:\n{result.stdout}\n")

# Clean up
os.unlink(c_filename)
os.unlink(executable)

# Print results
for result in results:
    print(result)
