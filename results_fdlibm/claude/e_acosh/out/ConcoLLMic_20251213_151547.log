import struct

# Convert 1.0 to IEEE-754 binary representation
def double_to_hex(d):
    # Pack the double into 8 bytes
    packed = struct.pack('>d', d)
    # Convert to hex representation
    hex_repr = ''.join(f'{b:02x}' for b in packed)
    return hex_repr

# Get high and low words (assuming little-endian architecture for __LO macro)
def get_high_low_words(d):
    # Pack the double into 8 bytes
    packed = struct.pack('d', d)
    # Extract high and low 32-bit words (little-endian)
    low_word = struct.unpack('I', packed[0:4])[0]
    high_word = struct.unpack('I', packed[4:8])[0]
    return high_word, low_word

# Check representation of 1.0
