import struct

def check_constraints(value):
    # Convert float to its binary representation
    binary = struct.unpack('Q', struct.pack('d', value))[0]
    
    # Extract high and low 32 bits
    i1 = binary & 0xFFFFFFFF  # Low 32 bits
    i0 = (binary >> 32) & 0xFFFFFFFF  # High 32 bits
    
    # Calculate j0 as in the constraint
    j0 = ((i0 >> 20) & 0x7ff) - 0x3ff
    
    # Check if j0 is in the range [0, 19]
    j0_in_range = 0 <= j0 < 20
    
    # Calculate the mask i
    i = (0x000fffff) >> j0
    
    # Check if ((i0&i)|i1) != 0
    condition_met = ((i0 & i) | i1) != 0
    
    return {
        "value": value,
        "j0": j0,
        "j0_in_range": j0_in_range,
        "condition_met": condition_met,
        "overall_satisfied": j0_in_range and condition_met
    }

# Test various values
test_values = [1.0, 1.5, 2.0, 3.14, 10.5, 100.75, 1000.0, 1048576.0, 2097152.0]
for value in test_values:
    result = check_constraints(value)
    print(f"Value: {value}")
    print(f"  j0: {result['j0']}")
    print(f"  j0 in range [0,19]: {result['j0_in_range']}")
    print(f"  ((i0&i)|i1) != 0: {result['condition_met']}")
    print(f"  All constraints satisfied: {result['overall_satisfied']}")
    print()
