import struct

def float_to_hex(f):
    # Convert float to its IEEE 754 hex representation
    b = struct.pack('>d', f)
    i = struct.unpack('>Q', b)[0]
    return hex(i)

def get_high_word(f):
    # Get the high word (first 32 bits) of the double
    b = struct.pack('>d', f)
    i = struct.unpack('>I', b[0:4])[0]
    return hex(i)

