import struct
import binascii

def get_exponent(value):
    """Extract the exponent field (k) from a double value."""
    binary = struct.pack('>d', value)
    bits = int(binascii.hexlify(binary).decode(), 16)
    high_word = (bits >> 32) & 0xffffffff
    k = (high_word & 0x7ff00000) >> 20
    return k

def create_double_with_exponent(exponent, mantissa=0):
    """Create a double with a specific exponent field value."""
    # Ensure exponent is in valid range
    if exponent < 0 or exponent > 0x7ff:
        raise ValueError("Exponent must be between 0 and 0x7ff")
    
    # Create the bits
    sign_bit = 0  # Positive number
    bits = (sign_bit << 63) | (exponent << 52) | mantissa
    
    # Convert to double
    binary = binascii.unhexlify(f"{bits:016x}")
    value = struct.unpack('>d', binary)[0]
    return value

def check_constraints(x, n):
    """Check if the given x and n satisfy our constraints."""
    k = get_exponent(x)
    
    # Constraints
    c1 = k != 0  # k must not be 0
    c2 = k != 0x7ff  # k must not be 0x7ff
    c3 = k + n > 0  # k + n must be positive
    c4 = k + n <= 0x7fe  # k + n must not exceed 0x7fe
    
    return {
        "x": x,
        "n": n,
        "k": k,
        "k+n": k + n,
        "c1 (k != 0)": c1,
        "c2 (k != 0x7ff)": c2,
        "c3 (k + n > 0)": c3,
        "c4 (k + n <= 0x7fe)": c4,
        "all_satisfied": c1 and c2 and c3 and c4
    }

# Test some values
test_cases = [
    (1.0, 1),        # Normal case, positive k and n
    (1.0, -1000),    # Normal k, large negative n
    (1.0, -1023),    # Edge case: k + n = 0
    (1.0, -1024),    # Edge case: k + n < 0
    (create_double_with_exponent(10), -5)  # Small k, negative n but k+n > 0
]

for x, n in test_cases:
    result = check_constraints(x, n)
    print(f"x = {x}, n = {n}")
    for key, value in result.items():
        print(f"  {key}: {value}")
    print()

# Find a valid solution
print("Finding a valid solution...")
# Let's try with k = 5 and n = -3
x = create_double_with_exponent(5)
n = -3
result = check_constraints(x, n)
print(f"Solution: x = {x}, n = {n}")
for key, value in result.items():
    print(f"  {key}: {value}")
