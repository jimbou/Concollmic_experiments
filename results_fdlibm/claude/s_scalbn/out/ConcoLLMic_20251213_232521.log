import struct

# Let's verify that "inf" indeed has exponent field 0x7ff
def analyze_double(value):
    # Convert float to its IEEE 754 binary representation
    binary = struct.pack('>d', value)
    # Convert binary to hexadecimal representation
    hex_repr = ''.join(f'{byte:02x}' for byte in binary)
    
    # Extract the sign, exponent, and mantissa bits
    sign_bit = (binary[0] & 0x80) >> 7
    exponent = ((binary[0] & 0x7F) << 4) | ((binary[1] & 0xF0) >> 4)
    mantissa = ((binary[1] & 0x0F) << 48) | (binary[2] << 40) | (binary[3] << 32) | \
               (binary[4] << 24) | (binary[5] << 16) | (binary[6] << 8) | binary[7]
    
    return {
        'value': value,
        'hex': hex_repr,
        'sign': sign_bit,
        'exponent': hex(exponent),
        'mantissa': hex(mantissa)
    }

# Analyze different special values
