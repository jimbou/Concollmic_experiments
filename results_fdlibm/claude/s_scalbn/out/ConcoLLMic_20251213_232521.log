import struct
import binascii

# Function to display the bit representation of a double
def show_double_bits(value):
    # Convert double to its IEEE 754 binary representation
    binary = struct.pack('>d', value)
    # Convert to hex for easier reading
    hex_repr = binascii.hexlify(binary).decode()
    
    # Extract the components
    bin_repr = ''.join(bin(int(c, 16))[2:].zfill(4) for c in hex_repr)
    sign = bin_repr[0]
    exponent = bin_repr[1:12]
    mantissa = bin_repr[12:]
    
    # Print the components
    print(f"Value: {value}")
    print(f"Hex: {hex_repr}")
    print(f"Sign bit: {sign}")
    print(f"Exponent bits: {exponent} (hex: {hex(int(exponent, 2))})")
    print(f"Mantissa bits: {mantissa}")
    print()

# Test with regular value
show_double_bits(1.0)

# Test with infinity
show_double_bits(float('inf'))

# Test with NaN
show_double_bits(float('nan'))

# Test with very large number
show_double_bits(1.8e308)
