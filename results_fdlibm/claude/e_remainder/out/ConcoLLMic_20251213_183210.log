import struct
import math

def float_to_hex(f):
    # Convert float to its hex representation
    b = struct.pack('>d', f)
    high_word = (b[0] << 24) | (b[1] << 16) | (b[2] << 8) | b[3]
    low_word = (b[4] << 24) | (b[5] << 16) | (b[6] << 8) | b[7]
    return high_word, low_word

# Test regular numbers
print("Regular number 1.0:", hex(float_to_hex(1.0)[0]), hex(float_to_hex(1.0)[1]))

# Test infinity
print("Positive infinity:", hex(float_to_hex(float('inf'))[0]), hex(float_to_hex(float('inf'))[1]))
print("Negative infinity:", hex(float_to_hex(float('-inf'))[0]), hex(float_to_hex(float('-inf'))[1]))

# Test NaN
print("NaN:", hex(float_to_hex(float('nan'))[0]), hex(float_to_hex(float('nan'))[1]))

# Check our target condition
def check_condition(x, p):
    hx, lx = float_to_hex(x)
    hp, lp = float_to_hex(p)
    
    condition1 = hx >= 0x7ff00000
    condition2 = (hp >= 0x7ff00000) and (((hp - 0x7ff00000) | lp) != 0)
    
    result = condition1 or condition2
    
    print(f"x = {x}, p = {p}")
    print(f"hx = {hex(hx)}, lx = {hex(lx)}")
    print(f"hp = {hex(hp)}, lp = {hex(lp)}")
    print(f"condition1: {condition1}")
    print(f"condition2: {condition2}")
    print(f"Result: {result}")
    return result

# Test with different combinations
print("\nTest 1: x = inf, p = 1.0")
check_condition(float('inf'), 1.0)

print("\nTest 2: x = 1.0, p = nan")
check_condition(1.0, float('nan'))

print("\nTest 3: x = nan, p = 1.0")
check_condition(float('nan'), 1.0)

print("\nTest 4: x = inf, p = inf")
check_condition(float('inf'), float('inf'))
