import struct

# Function to convert a float to its hexadecimal representation
def float_to_hex(f):
    # Convert float to its IEEE 754 representation
    b = struct.pack('>d', f)
    # Convert to integer and format as hex
    i = struct.unpack('>Q', b)[0]
    # Extract high 32 bits (hx)
    hx = (i >> 32) & 0xFFFFFFFF
    # Extract low 32 bits (lx)
    lx = i & 0xFFFFFFFF
    return hx, lx

# Test with different values
test_values = [
    float('inf'),  # Infinity
    float('nan'),  # NaN
    1.0            # Regular number
]

