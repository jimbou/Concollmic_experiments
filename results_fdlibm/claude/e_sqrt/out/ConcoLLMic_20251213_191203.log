import struct
import binascii

def float_to_hex(f):
    # Convert float to its hex representation
    packed = struct.pack('>d', f)
    # Get the integer representation of the packed bytes
    integer_rep = int.from_bytes(packed, byteorder='big')
    # Convert to hex string
    hex_rep = hex(integer_rep)
    return hex_rep

# Check regular value
print("1.0 in hex:", float_to_hex(1.0))

# Check infinity
import math
print("Positive infinity in hex:", float_to_hex(float('inf')))
print("Negative infinity in hex:", float_to_hex(float('-inf')))
print("NaN in hex:", float_to_hex(float('nan')))

# Extract just the exponent bits (bits 20-30 in the high word)
def check_exponent_bits(f):
    packed = struct.pack('>d', f)
    high_word = int.from_bytes(packed[0:4], byteorder='big')
    exponent_mask = 0x7ff00000
    result = high_word & exponent_mask
    print(f"Value: {f}")
    print(f"High word: {hex(high_word)}")
    print(f"After mask: {hex(result)}")
    print(f"Expected:   {hex(exponent_mask)}")
    print(f"Match: {result == exponent_mask}")

print("\nChecking exponent bits:")
check_exponent_bits(1.0)
check_exponent_bits(float('inf'))
check_exponent_bits(float('nan'))
