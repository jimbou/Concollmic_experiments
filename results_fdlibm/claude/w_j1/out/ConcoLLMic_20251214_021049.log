        print("\nExecution output with LD_PRELOAD:")
        print(f"STDOUT: {run_result.stdout}")
        print(f"STDERR: {run_result.stderr}")
        print(f"Return code: {run_result.returncode}")
    
except Exception as e:
    print(f"Error: {e}")
