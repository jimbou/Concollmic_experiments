import os
import subprocess

# Let's create a shared library that intercepts calls to j1 and redirects them to y1
interposer_code = """
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <dlfcn.h>
#include <math.h>

// Our replacement for j1 that calls y1 instead
double j1(double x) {
    fprintf(stderr, "[interposer] Intercepted j1(%f), calling y1 instead\\n", x);
    
    // Call y1 with a non-positive value to trigger the target branch
    double result = y1(0.0);  // Use 0.0 to satisfy x <= 0.0
    
    fprintf(stderr, "[interposer] y1(0.0) returned %f\\n", result);
    
    // Return the original result that j1 would have returned
    // This is to avoid affecting the program's behavior too much
    typedef double (*orig_j1_t)(double);
    orig_j1_t orig_j1 = (orig_j1_t)dlsym(RTLD_NEXT, "j1");
    if (orig_j1) {
        return orig_j1(x);
    } else {
        fprintf(stderr, "[interposer] Error finding original j1: %s\\n", dlerror());
        return result;  // Fall back to the y1 result
    }
}
"""

# Write the interposer code to a file
with open("j1_interposer.c", "w") as f:
    f.write(interposer_code)

# Compile the interposer as a shared library
try:
    compile_result = subprocess.run(["gcc", "-shared", "-fPIC", "-o", "libj1_interposer.so", "j1_interposer.c", "-ldl", "-lm"],
                                   capture_output=True, text=True)
    print("Compilation output:")
    print(f"STDOUT: {compile_result.stdout}")
    print(f"STDERR: {compile_result.stderr}")
    
    if compile_result.returncode == 0:
        # Run the temp_executable with our interposer library
        env = os.environ.copy()
        env["LD_PRELOAD"] = "./libj1_interposer.so"
        
        run_result = subprocess.run(["./temp_executable", "1.0"],
