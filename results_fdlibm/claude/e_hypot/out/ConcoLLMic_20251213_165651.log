import struct
import math

# Function to extract high-order 32 bits of a double
def get_high_bits(d):
    # Convert double to its IEEE 754 representation (8 bytes)
    bytes_val = struct.pack('>d', d)
    # Extract the high-order 32 bits (first 4 bytes)
    high_bits = struct.unpack('>I', bytes_val[0:4])[0]
    return high_bits

# Function to mask the sign bit
def mask_sign_bit(bits):
    return bits & 0x7fffffff

# Let's test with different powers of 10
for i in range(100, 201, 10):
    val = 10.0 ** i
    high_bits = get_high_bits(val)
    masked_bits = mask_sign_bit(high_bits)
    print(f"10^{i} = {val:.2e}, high bits = 0x{high_bits:08x}, masked = 0x{masked_bits:08x}")
    if masked_bits > 0x5f300000:
        print(f"  SUCCESS: 10^{i} has masked high bits > 0x5f300000")

# Let's also check the target value
target = 0x5f300000
print(f"\nTarget value: 0x{target:08x}")
