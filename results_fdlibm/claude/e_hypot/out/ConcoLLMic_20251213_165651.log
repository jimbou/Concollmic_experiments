import struct

def get_high_word(value):
    # Convert float to its IEEE 754 binary representation
    binary = struct.pack('>d', value)
    # Extract high word (first 4 bytes in big-endian)
    high_word = struct.unpack('>I', binary[:4])[0]
    return high_word

def check_condition(value):
    high_word = get_high_word(value)
    masked_high = high_word & 0x7fffffff
    print(f"Value: {value}")
    print(f"High word: 0x{high_word:08x}")
    print(f"Masked high word: 0x{masked_high:08x}")
    print(f"Condition (masked_high >= 0x7ff00000): {masked_high >= 0x7ff00000}")
    print()

# Test with different values
check_condition(1.0)                  # Regular number
check_condition(1.0e+308)             # Very large but valid number
check_condition(float('inf'))         # Positive infinity
check_condition(float('-inf'))        # Negative infinity
check_condition(float('nan'))         # NaN
