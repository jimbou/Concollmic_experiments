import struct

def get_high_bits(f):
    # Convert float to its IEEE-754 representation
    bits = struct.unpack('>Q', struct.pack('>d', f))[0]
    # Extract high 32 bits
    high_bits = (bits >> 32) & 0xFFFFFFFF
    # Mask with 0x7fffffff to remove sign bit
    masked_high_bits = high_bits & 0x7fffffff
    return high_bits, masked_high_bits

# Original execution values
x1 = 3.3e+150
y1 = 1.0

# Proposed values (swapped)
