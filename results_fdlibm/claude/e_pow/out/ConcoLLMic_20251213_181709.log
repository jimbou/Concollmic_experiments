# Test a few representative values
for test_val in ["inf", "Infinity", "-inf", "nan", "NaN"]:
    print(f"\n--- Testing '{test_val}' ---")
    result = subprocess.run(["./test_float", test_val], capture_output=True, text=True)
    print(result.stdout)
