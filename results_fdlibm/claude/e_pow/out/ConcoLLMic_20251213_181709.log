# Let's verify how Python represents infinity and NaN in IEEE 754 format
import struct
import math

def float_to_hex(f):
    # Convert float to its hexadecimal representation
    return hex(struct.unpack('<Q', struct.pack('<d', f))[0])

# Test with infinity and NaN
print(f"Positive infinity: {float_to_hex(float('inf'))}")
print(f"Negative infinity: {float_to_hex(float('-inf'))}")
print(f"NaN: {float_to_hex(float('nan'))}")

# Let's also check the bit patterns to confirm they match our constraints
inf_bits = struct.unpack('<Q', struct.pack('<d', float('inf')))[0]
ninf_bits = struct.unpack('<Q', struct.pack('<d', float('-inf')))[0]
nan_bits = struct.unpack('<Q', struct.pack('<d', float('nan')))[0]

# Extract exponent bits (11 bits after sign bit)
inf_exp = (inf_bits >> 52) & 0x7FF
ninf_exp = (ninf_bits >> 52) & 0x7FF
nan_exp = (nan_bits >> 52) & 0x7FF

# Extract fraction bits (52 least significant bits)
inf_frac = inf_bits & 0xFFFFFFFFFFFFF
ninf_frac = ninf_bits & 0xFFFFFFFFFFFFF
nan_frac = nan_bits & 0xFFFFFFFFFFFFF

print(f"\nInfinity exponent: {hex(inf_exp)} (should be 0x7ff)")
print(f"Infinity fraction: {hex(inf_frac)} (should be 0 for infinity)")

print(f"\nNegative infinity exponent: {hex(ninf_exp)} (should be 0x7ff)")
print(f"Negative infinity fraction: {hex(ninf_frac)} (should be 0 for infinity)")

print(f"\nNaN exponent: {hex(nan_exp)} (should be 0x7ff)")
print(f"NaN fraction: {hex(nan_frac)} (should be non-zero for NaN)")
