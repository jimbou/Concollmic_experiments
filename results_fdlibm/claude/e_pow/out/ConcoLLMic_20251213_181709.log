# Let's verify that the shell will correctly parse and pass infinity and NaN values
import subprocess

# Test different ways to represent infinity and NaN in shell commands
test_values = ["inf", "Inf", "INF", "infinity", "Infinity", "INFINITY", 
               "-inf", "-Inf", "-INF", "-infinity", "-Infinity", "-INFINITY",
               "nan", "NaN", "NAN"]

print("Testing how shell passes special floating point values to a C program:")

# Create a simple C program that prints the parsed floating point values
with open("test_float.c", "w") as f:
    f.write("""
    #include <stdio.h>
    #include <stdlib.h>
    #include <math.h>
    
    int main(int argc, char *argv[]) {
        if (argc < 2) {
            printf("Usage: %s <float_value>\\n", argv[0]);
            return 1;
        }
        
        double value = atof(argv[1]);
        
        printf("Input string: %s\\n", argv[1]);
        printf("Parsed value: %f\\n", value);
        printf("isnan: %d\\n", isnan(value));
        printf("isinf: %d\\n", isinf(value));
        
        return 0;
    }
    """)

# Compile the test program
