import struct
import ctypes
import sys

# This approach uses ctypes to get the exact bit representation
class DoubleBits(ctypes.Union):
    _fields_ = [("d", ctypes.c_double),
                ("b", ctypes.c_uint64)]

def analyze_double(value):
    bits = DoubleBits()
    bits.d = value
    
    # Extract the sign, exponent, and mantissa
    sign = (bits.b >> 63) & 1
    exponent = (bits.b >> 52) & 0x7FF
    mantissa = bits.b & 0xFFFFFFFFFFFFF
    
    # For a 64-bit double, the high word is the upper 32 bits
    high_word = (bits.b >> 32) & 0xFFFFFFFF
    low_word = bits.b & 0xFFFFFFFF
    
    # For the absolute value, we just clear the sign bit in the high word
    abs_high_word = high_word & 0x7FFFFFFF
    
    print(f"Value: {value}")
    print(f"Bits: 0x{bits.b:016x}")
    print(f"Sign: {sign}, Exponent: {exponent}, Mantissa: 0x{mantissa:013x}")
    print(f"High word: 0x{high_word:08x}")
    print(f"Low word: 0x{low_word:08x}")
    print(f"Abs high word: 0x{abs_high_word:08x}")
    
    # Check constraints
    print(f"1. hx < 0x3FDA827A: {high_word < 0x3FDA827A}")
    print(f"2. ax >= 0x3e200000: {abs_high_word >= 0x3e200000}")
    print(f"3. ax < 0x3ff00000: {abs_high_word < 0x3ff00000}")
    print(f"4. hx > 0 OR hx <= 0xbfd2bec3: {high_word > 0 or high_word <= 0xbfd2bec3}")
    print(f"   - hx > 0: {high_word > 0}")
    print(f"   - hx <= 0xbfd2bec3: {high_word <= 0xbfd2bec3}")
    print()

# Test with -0.2 and 0.2
analyze_double(-0.2)
analyze_double(0.2)

# Let's also try 0.1 and -0.1
