import struct

# Convert a float to its hexadecimal representation using native byte order
def float_to_hex(f):
    # IEEE 754 double-precision format
    binary = struct.pack('d', float(f))
    # Get high and low words (32 bits each)
    if struct.pack('=I', 1) == struct.pack('<I', 1):  # Little endian
        high = binary[4:8]
        low = binary[0:4]
    else:  # Big endian
        high = binary[0:4]
        low = binary[4:8]
    high_int = int.from_bytes(high, byteorder='big')
    low_int = int.from_bytes(low, byteorder='big')
    return f"High word: 0x{high_int:08x}, Low word: 0x{low_int:08x}"

# Let's check the bit representation of -0.2
print("-0.2:", float_to_hex(-0.2))

