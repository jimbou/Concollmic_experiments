    # Pack the double into bytes
    binary = struct.pack('d', x)
    # Extract the high word based on endianness
    if struct.pack('=I', 1) == struct.pack('<I', 1):  # Little endian
        high_bytes = binary[4:8]
    else:  # Big endian
        high_bytes = binary[0:4]
    # Convert to integer
    return int.from_bytes(high_bytes, byteorder='big')

