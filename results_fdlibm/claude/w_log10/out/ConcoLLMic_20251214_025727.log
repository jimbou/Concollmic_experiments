    c_code = """
    #define _SVID_SOURCE 1
    #include <stdio.h>
    #include <math.h>
    #include <stdlib.h>
    #include <errno.h>
    
    int main() {
        double x = -1.0;
        
        // Set errno to 0 before the call
        errno = 0;
        
        // Call log10 with a negative number
        double result = log10(x);
        
        // Check the result and errno
        if (result != result) { // NaN check
            printf("log10(-1.0) returned NaN\\n");
        } else {
            printf("log10(-1.0) returned: %f\\n", result);
        }
        
        printf("errno after call: %d\\n", errno);
        if (errno == EDOM) {
            printf("Domain error occurred (EDOM)\\n");
        } else if (errno == ERANGE) {
            printf("Range error occurred (ERANGE)\\n");
