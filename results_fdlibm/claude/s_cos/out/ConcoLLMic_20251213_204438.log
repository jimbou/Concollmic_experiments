import struct

# Function to get high 32 bits of a double
def get_high_bits(d):
    # Convert double to its IEEE 754 representation (8 bytes)
    binary = struct.pack('>d', d)
    # Extract high 32 bits (first 4 bytes)
    high_bits = binary[0:4]
    # Convert to integer
    high_int = int.from_bytes(high_bits, byteorder='big')
    # Mask out sign bit
    return high_int & 0x7fffffff

# Check if 1.0 satisfies the constraints
