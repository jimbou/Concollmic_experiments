import struct
import binascii

# Function to convert a float to its hexadecimal representation
def float_to_hex(f):
    # Pack the float into bytes using IEEE 754 format
    packed = struct.pack('>d', f)
    # Convert to hexadecimal
    hex_repr = binascii.hexlify(packed).decode('utf-8')
    return hex_repr

# Check representation of special values
special_values = {
    "positive_inf": float('inf'),
    "negative_inf": float('-inf'),
    "nan": float('nan')
}

for name, value in special_values.items():
    hex_value = float_to_hex(value)
    print(f"{name}: {value}, hex: {hex_value}")
    
    # Extract the high word (first 4 bytes in big-endian)
    high_word = int(hex_value[:8], 16)
    # Mask off the sign bit
    masked_high_word = high_word & 0x7fffffff
    print(f"High word (masked): 0x{masked_high_word:08x}")
    print(f"Is >= 0x7ff00000? {masked_high_word >= 0x7ff00000}")
    print()
