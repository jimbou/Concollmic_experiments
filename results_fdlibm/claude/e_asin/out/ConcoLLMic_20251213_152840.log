# Convert 0.75 to IEEE 754 representation
def float_to_hex(f):
    # Get the IEEE 754 binary representation as a hexadecimal string
    binary = struct.pack('>d', f)
    hex_representation = ''.join(f'{byte:02x}' for byte in binary)
    
    # Extract the high word (first 4 bytes for a double)
    high_word = int(hex_representation[:8], 16)
    
    # Mask out the sign bit (highest bit)
    ix = high_word & 0x7fffffff
    
