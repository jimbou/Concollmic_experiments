import struct

def double_to_hex(value):
    # Convert double to its hex representation
    packed = struct.pack('>d', value)
    high_word = packed[:4].hex()
    low_word = packed[4:].hex()
    return f"0x{high_word} 0x{low_word}"

def get_high_word_without_sign(value):
    # Convert double to its hex representation
    packed = struct.pack('>d', value)
    # Extract high word (first 4 bytes) and convert to int
    high_word = int.from_bytes(packed[:4], byteorder='big')
    # Remove sign bit with & 0x7fffffff
    high_word_without_sign = high_word & 0x7fffffff
    return f"0x{high_word_without_sign:08x}"

# Test values
test_values = [0.4, 0.4375, 0.5, 1.0]

for value in test_values:
    print(f"Value: {value}")
    print(f"  Full hex: {double_to_hex(value)}")
    print(f"  High word without sign (ix): {get_high_word_without_sign(value)}")
    print(f"  ix >= 0x3fdc0000: {int(get_high_word_without_sign(value), 16) >= 0x3fdc0000}")
    print()

# Also check negative values
for value in [-0.4, -0.4375, -0.5, -1.0]:
    print(f"Value: {value}")
    print(f"  Full hex: {double_to_hex(value)}")
    print(f"  High word without sign (ix): {get_high_word_without_sign(value)}")
    print(f"  ix >= 0x3fdc0000: {int(get_high_word_without_sign(value), 16) >= 0x3fdc0000}")
    print()

# Check the exact threshold
print(f"0x3fdc0000 as double: {struct.unpack('>d', bytes.fromhex('3fdc000000000000'))[0]}")
