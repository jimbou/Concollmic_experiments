# Function to extract the high word (most significant 32 bits) of a double
def get_high_word(value):
    # Pack the double into bytes
    packed = struct.pack('>d', value)
    # Extract the high word (first 4 bytes in big-endian)
    high_word = struct.unpack('>I', packed[:4])[0]
    return high_word

# Check various special values
print(f"Positive infinity: 0x{get_high_word(float('inf')):08x}")
print(f"Negative infinity: 0x{get_high_word(float('-inf')):08x}")
print(f"NaN: 0x{get_high_word(float('nan')):08x}")

# Also check a very large number
large_num = 1.8e308  # Slightly larger than DBL_MAX
print(f"Large number: 0x{get_high_word(large_num):08x}")

# Check the current value used in the execution
print(f"Current value (1.0): 0x{get_high_word(1.0):08x}")
