# Let's analyze the IEEE 754 representation of various double values
import struct

def analyze_double(value):
    # Convert double to its IEEE 754 binary representation
    binary = struct.pack('>d', value)
    # Convert to 64-bit integer
    bits = int.from_bytes(binary, byteorder='big')
    # Extract high and low words (32 bits each)
    high_word = (bits >> 32) & 0xFFFFFFFF
    low_word = bits & 0xFFFFFFFF
    # Extract sign bit
    sign = high_word & 0x80000000
    # Remove sign bit
    high_word_no_sign = high_word ^ sign
    
    print(f"Value: {value}")
    print(f"Binary: 0x{bits:016X}")
    print(f"High word (hx): 0x{high_word:08X}")
    print(f"Low word: 0x{low_word:08X}")
    print(f"Sign bit: 0x{sign:08X}")
    print(f"High word without sign (hx^sign): 0x{high_word_no_sign:08X}")
    print(f"Check hx >= 0x00100000: {high_word_no_sign >= 0x00100000}")
    print(f"Check hx < 0x7ff00000: {high_word_no_sign < 0x7ff00000}")
    print(f"Check (hx|low_word) != 0: {(high_word_no_sign|low_word) != 0}")
    print(f"All conditions met: {high_word_no_sign >= 0x00100000 and high_word_no_sign < 0x7ff00000 and (high_word_no_sign|low_word) != 0}")
