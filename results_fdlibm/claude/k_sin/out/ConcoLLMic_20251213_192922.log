import binascii

# Function to get the high word of a float (similar to __HI macro)
def get_high_word(f):
    # Convert float to its IEEE 754 representation
    b = struct.pack('>f', f)
    # Extract the high 32 bits and convert to integer
    high_word = int.from_bytes(b[:4], byteorder='big')
    return high_word

