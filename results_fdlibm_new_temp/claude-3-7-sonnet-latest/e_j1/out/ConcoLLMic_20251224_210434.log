# Let's verify our understanding of IEEE 754 double-precision format
import struct

# Function to convert a float to its IEEE 754 representation
def float_to_hex(f):
    # Convert float to its IEEE 754 binary representation
    b = struct.pack('>d', f)
    # Convert binary to hexadecimal representation
    h = '0x{:016x}'.format(struct.unpack('>Q', b)[0])
    # Extract high word (most significant 32 bits)
    high_word = '0x{:08x}'.format(struct.unpack('>Q', b)[0] >> 32)
    # Extract high word with sign bit masked off
    high_word_no_sign = '0x{:08x}'.format((struct.unpack('>Q', b)[0] >> 32) & 0x7fffffff)
    return {
        'full_hex': h,
        'high_word': high_word,
        'high_word_no_sign': high_word_no_sign
    }

# Test with different values
test_values = [1.0, 1.5, 2.0, 2.5, -2.0, 3.0, 10.0]

for val in test_values:
    hex_rep = float_to_hex(val)
    print(f"Value: {val}")
    print(f"  Full hex: {hex_rep['full_hex']}")
    print(f"  High word: {hex_rep['high_word']}")
    print(f"  High word (no sign): {hex_rep['high_word_no_sign']}")
    print(f"  >= 0x40000000: {int(hex_rep['high_word_no_sign'], 16) >= 0x40000000}")
    print()
