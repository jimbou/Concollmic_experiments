import subprocess
import signal
import os


def execute_program(timeout: int) -> tuple[str, int]:
    exe = "./temp_executable"

    # Provide exactly one scientific-notation token followed by a single LF.
    # This satisfies: [0-9]+(\.[0-9]+)?e[+-]?[0-9]+ with lowercase 'e',
    # not equal to "0" or "1", no embedded spaces/NULs, and at least three
    # characters after 'e' ("+34").
    input_data = "12e+34\n"

    # Force C locale to ensure '.' decimal and consistent numeric parsing.
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    env["LC_NUMERIC"] = "C"

    try:
        result = subprocess.run(
            [str(exe)],
            input=input_data,
            text=True,
            capture_output=True,
            timeout=timeout,
            env=env,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return e.stderr, -signal.SIGKILL

    except Exception:
        raise

