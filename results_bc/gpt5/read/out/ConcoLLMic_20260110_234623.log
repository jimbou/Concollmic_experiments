import subprocess
import signal

def execute_program(timeout: int) -> tuple[str, int]:
    """
    Execute the target program with a single input line that contains a non-text byte
    before the newline to trigger bc_read_binary(...) and reach the target branch.

    Input sent on stdin (as text encoded to bytes):
    - "1\x01\n"
