import subprocess
import signal

def execute_program(timeout: int) -> tuple[str, int]:
    """
    Execute the target program with stdin containing a single newline-terminated line
    that includes a non-text (binary) byte before the newline. We provide the byte 0x01
    followed by a newline (0x0A), i.e., b"\x01\n". Using text=True with the Python string
    "\x01\n" ensures the underlying transmitted bytes are 0x01 0x0A.
    """
    exe = "./temp_executable"

    try:
        # Provide one line: [0x01] then newline 0x0A
        # No command-line arguments, stdin connected, and no special environment variables.
        result = subprocess.run(
            [str(exe)],
            input="\x01\n",
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return e.stderr, -signal.SIGKILL

    except Exception:
        raise

