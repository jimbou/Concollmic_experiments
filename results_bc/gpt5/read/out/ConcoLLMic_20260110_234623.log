            input="1\x01\n",      # single line payload with a binary byte before LF
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return e.stderr, -signal.SIGKILL

    except Exception:
        raise

