import os
import subprocess
import signal
from typing import Tuple


def execute_program(timeout: int) -> Tuple[str, int]:
    """
    Execute the original test harness (./temp_executable) with environment variables set
    to satisfy the target path constraints so that bc_vm_exprs() takes the branch
    if (!clear) -> true.

    Key points:
    - No positional command-line arguments (argc == 1).
    - BC_ENV_ARGS/DC_ENV_ARGS begin with a dummy first token, then pairs of -e <expr>.
    - First expression ends with a backslash; a newline is inserted between expressions,
      yielding \\\n as the buffer suffix for the first read, making clear=false.
    - BC_EXPR_EXIT set to 0 to prevent exit-after-expressions.
    - Stdin provided as empty string to avoid extra input.
    """
    exe = "./temp_executable"

    # Build environment with a dummy first token, then -e expr pairs.
    # First expr ends with a backslash; second expr begins with '+' to form a valid continuation.
    env = os.environ.copy()
    env["BC_ENV_ARGS"] = "dummy -e 2+3\\ -e +4"
    env["DC_ENV_ARGS"] = "dummy -e 2+3\\ -e +4"  # acceptable if the binary is dc-compatible
    env["BC_EXPR_EXIT"] = "0"  # disable auto-exit after expressions

    try:
        result = subprocess.run(
            [str(exe)],
            input="",                 # keep stdin open but empty
            text=True,
            capture_output=True,
            timeout=timeout,
            env=env,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return (e.stderr if getattr(e, "stderr", None) is not None else ""), -signal.SIGKILL

    except Exception:
        raise

