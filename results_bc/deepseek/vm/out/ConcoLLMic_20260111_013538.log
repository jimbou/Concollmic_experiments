import subprocess
import signal

def test_various_errors():
    exe = "./temp_executable"
    
    test_cases = [
        ("Division by zero", "1/0\n"),
        ("Syntax error - unbalanced parentheses", "(1+2\n"),
        ("Syntax error - invalid operator", "1++2\n"),
        ("Undefined variable", "x\n"),
        ("Invalid function call", "undefined_function()\n"),
        ("Very large exponent", "2^1000000\n"),
        ("Complex invalid expression", "1/0 + (2*\n"),
        ("Empty input", "\n"),
        ("Just quit command", "quit\n"),
    ]
    
    for test_name, test_input in test_cases:
        print(f"\n=== Testing: {test_name} ===")
        print(f"Input: {repr(test_input)}")
        
        try:
            result = subprocess.run(
                [str(exe)],
                input=test_input,
                text=True,
                capture_output=True,
                timeout=3,
            )
            print(f"Return code: {result.returncode}")
            if result.stderr:
                # Look for fatal error indicators in stderr
                stderr_lines = result.stderr.split('\n')
                for i, line in enumerate(stderr_lines):
                    if 'fatal' in line.lower() or 'BC_STATUS_ERROR_FATAL' in line:
                        print(f"FATAL ERROR INDICATOR: {line}")
                    if 'bc_vm_handleError' in line:
                        # Check the line number to see if it's the fatal branch
                        print(f"Error handler called: {line}")
            
        except subprocess.TimeoutExpired as e:
