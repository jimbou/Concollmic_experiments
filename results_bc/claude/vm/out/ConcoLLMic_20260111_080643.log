import subprocess
import signal
import tempfile
import os

def execute_program(timeout: int) -> tuple[str, int]:
    exe = "./temp_executable"
    
    # Create a temporary file with a very large number followed by a float
    # This should cause the program to attempt to allocate a huge vector
    # which will fail and trigger the target branch in bc_vm_malloc()
    with tempfile.NamedTemporaryFile(mode='w', delete=False) as temp_file:
        # Using a very large number (close to 2^63-1) followed by a float
        # This should be parseable but cause allocation failure
        temp_file.write("9223372036854775807 3.14")
        temp_file_path = temp_file.name
    
    try:
        # Execute the program with the temp file path as argument
        result = subprocess.run(
            [str(exe), temp_file_path],  # Pass file path as command-line argument
            input="1+1\n",               # Keep the original stdin input
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        return result.stderr, result.returncode
    
    except subprocess.TimeoutExpired as e:
        return e.stderr, -signal.SIGKILL
    
    except Exception as e:
        raise
    
    finally:
        # Clean up the temporary file
        if os.path.exists(temp_file_path):
            os.unlink(temp_file_path)
