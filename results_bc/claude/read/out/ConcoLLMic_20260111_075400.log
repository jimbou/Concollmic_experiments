import os
import signal
import subprocess
import time
import fcntl

# Let's try a simple test to see if we can interrupt the bc process
def test_signal_interrupt():
    # Start the bc process
    process = subprocess.Popen(
        ["./temp_executable"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )
    
    # Send partial input (no newline)
    process.stdin.write("1+1")
    process.stdin.flush()
    
    # Wait a bit to ensure bc is waiting for more input
    time.sleep(0.1)
    
    # Send SIGINT to the process
    print(f"Sending SIGINT to process {process.pid}")
    os.kill(process.pid, signal.SIGINT)
    
    # Wait a bit and then complete the input
    time.sleep(0.1)
    process.stdin.write("\n")
    process.stdin.flush()
    
    # Get the output
    stdout, stderr = process.communicate(timeout=1)
    
    print(f"Return code: {process.returncode}")
    print(f"Stdout: {stdout}")
    print(f"Stderr: {stderr}")
    
    return process.returncode, stdout, stderr

try:
    test_signal_interrupt()
except Exception as e:
    print(f"Exception: {e}")
