import subprocess
import time
import tempfile

def test_with_fifo():
    # Create a temporary directory for the FIFO
    temp_dir = tempfile.mkdtemp()
    fifo_path = os.path.join(temp_dir, "input_fifo")
    
    try:
        # Create the FIFO
        os.mkfifo(fifo_path)
        print(f"Created FIFO at {fifo_path}")
        
        # Start bc process reading from the FIFO
        process = subprocess.Popen(
            ["./temp_executable", "-i", fifo_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        
        # Wait a bit to ensure bc is waiting for input from the FIFO
        time.sleep(0.1)
        
        # Send SIGINT to the process
        print(f"Sending SIGINT to process {process.pid}")
        os.kill(process.pid, signal.SIGINT)
        
        # Wait a bit to allow signal handling
        time.sleep(0.1)
        
        # Open the FIFO for writing and send some data
        with open(fifo_path, "w") as fifo:
            fifo.write("1+1\n")
        
        # Get output with timeout
        try:
            stdout, stderr = process.communicate(timeout=1)
            print(f"Return code: {process.returncode}")
            print(f"Stdout: {stdout}")
            print(f"Stderr: {stderr}")
            
            # Check if the target branch was reached
            if "errno == EINTR" in stderr or "EINTR" in stderr:
                print("Target branch reached!")
            
        except subprocess.TimeoutExpired:
            print("Process timed out")
            process.kill()
            stdout, stderr = process.communicate()
            print(f"After kill - Return code: {process.returncode}")
            print(f"Stdout: {stdout}")
            print(f"Stderr: {stderr}")
    
    except Exception as e:
        print(f"Exception: {e}")
    finally:
        # Clean up
        if process.poll() is None:
            process.terminate()
            process.wait()
        
        # Remove the FIFO and temporary directory
        try:
            os.unlink(fifo_path)
            os.rmdir(temp_dir)
        except:
            pass

