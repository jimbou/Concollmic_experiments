                       "      case 'b': *out++ = '\\b'; break;\n"
                       "      case 'f': *out++ = '\\f'; break;\n"
                       "      case 't': *out++ = '\\t'; break;\n"
                       "      case 'n': *out++ = '\\n'; break;\n"
                       "      case 'r': *out++ = '\\r'; break;\n"
