import subprocess
import signal
from pathlib import Path
import tempfile
import os

def execute_program(timeout: int) -> tuple[str, int]:
    # Create a temporary C file that overrides malloc to always fail
    c_code = """
#include <stdlib.h>
#include <stdio.h>

void* malloc(size_t size) {
    return NULL;
}

void* calloc(size_t nmemb, size_t size) {
    return NULL;
}

void* realloc(void* ptr, size_t size) {
    return NULL;
}
"""
    
    # Write the C code to a temporary file
    with tempfile.NamedTemporaryFile(mode='w', suffix='.c', delete=False) as f:
        f.write(c_code)
        c_file = f.name
    
    # Compile the shared library
    so_file = c_file.replace('.c', '.so')
    compile_cmd = f"gcc -shared -fPIC -o {so_file} {c_file}"
    
    try:
        result = subprocess.run(compile_cmd, shell=True, capture_output=True, text=True)
        if result.returncode != 0:
            raise RuntimeError(f"Failed to compile malloc override library: {result.stderr}")
    except Exception as e:
        # Clean up temporary files
        if os.path.exists(c_file):
            os.unlink(c_file)
        raise RuntimeError(f"Error compiling malloc override: {e}")
    
    # Clean up the C file
    os.unlink(c_file)
    
    # Set up the environment with LD_PRELOAD
    env = os.environ.copy()
    env['LD_PRELOAD'] = so_file
    
    # Execute the program with the original test harness
    exe = "./temp_executable"
    json_input = "{}"
    
    try:
        result = subprocess.run(
            [str(exe), "."],  # Exactly 2 arguments: program name and JSON filter
            input=json_input,  # Valid JSON input via stdin
            text=True,
            capture_output=True,
            timeout=timeout,
            env=env  # Use environment with LD_PRELOAD
        )
        
        # Clean up the shared library
        if os.path.exists(so_file):
            os.unlink(so_file)
            
        return result.stderr, result.returncode
        
    except subprocess.TimeoutExpired as e:
        # Clean up the shared library
        if os.path.exists(so_file):
            os.unlink(so_file)
        return e.stderr or "", -signal.SIGKILL
    
    except Exception as e:
        # Clean up the shared library on any other exception
        if os.path.exists(so_file):
            os.unlink(so_file)
        raise
