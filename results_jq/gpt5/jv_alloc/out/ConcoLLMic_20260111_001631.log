import os
import subprocess
import signal
import resource
from pathlib import Path


def execute_program(timeout: int) -> tuple[str, int]:
    # Path to the jq binary (as per the original harness)
    exe = "./temp_executable"

    # Verify executable exists
    if not Path(exe).exists():
        raise FileNotFoundError(f"Executable not found at path: {exe}")

    # Construct a very large, valid JSON input to force repeated reallocations.
    # Using a single long string inside an object ensures contiguous buffer growth in the parser.
    # Size chosen to exceed imposed memory limits during parsing/printing.
    long_str_size = 100 * 1024 * 1024  # 100 MB
    long_str = "A" * long_str_size  # ASCII, valid UTF-8
    json_input = '{"k":"' + long_str + '"}'

    # Clean environment (no special variables to alter allocator behavior)
    env = os.environ.copy()

    # Pre-exec function to set strict memory limits in the child process
    def _limit_resources():
        # Impose a hard address space/data segment limit so realloc will fail when growing buffers
        limit_bytes = 64 * 1024 * 1024  # 64 MB
        try:
            resource.setrlimit(resource.RLIMIT_AS, (limit_bytes, limit_bytes))
        except Exception:
            # RLIMIT_AS may not be available or may fail on some systems; proceed best-effort
            pass
        try:
            resource.setrlimit(resource.RLIMIT_DATA, (limit_bytes, limit_bytes))
        except Exception:
            pass
        # Avoid generating core dumps
        try:
            resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        except Exception:
            pass

    try:
        # Execute jq with the identity filter, providing the large JSON on stdin.
        # Explicitly set UTF-8 encoding to satisfy I/O constraints.
        result = subprocess.run(
            [str(exe), "."],
            input=json_input,
            text=True,
            encoding="utf-8",
            capture_output=True,
            timeout=timeout,
            env=env,
            preexec_fn=_limit_resources,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        # Return timeout as negative SIGKILL to indicate forced termination, keeping the interface consistent
        return e.stderr or "", -signal.SIGKILL

