def execute_program(timeout: int) -> tuple[str, int]:
    import os
    import subprocess
    import signal
    import tempfile
    import resource

    exe = "./temp_executable"

    # Build a valid but very large JSON array to force heavy allocations in jq
    # We choose 15,000,000 zeros -> ~30MB of input, but far larger heap usage in jq
    # due to per-element representation and array storage overhead.
    N = 15_000_000
    tmp_path = None

    try:
        # Create the large JSON input in a temporary file to avoid holding it in memory
        with tempfile.NamedTemporaryFile('w', delete=False, encoding='utf-8') as f:
            tmp_path = f.name
            f.write('[')
            remaining = N - 1
            # Write in chunks to keep peak Python memory modest
            chunk_count = 1_000_000
            chunk = '0,' * chunk_count  # ~2MB per chunk write
            while remaining >= chunk_count:
                f.write(chunk)
                remaining -= chunk_count
            if remaining > 0:
                f.write('0,' * remaining)
            f.write('0]')

        # Resource limit setup for the child only: limit address space so that
        # jq's allocations during parsing/evaluation will fail with malloc() == NULL.
        def limit_resources():
            try:
                desired = 256 * 1024 * 1024  # 256 MiB address space limit
                # RLIMIT_AS: overall virtual memory
                soft, hard = resource.getrlimit(resource.RLIMIT_AS)
                new_soft = min(desired, hard if hard != resource.RLIM_INFINITY else desired)
                resource.setrlimit(resource.RLIMIT_AS, (new_soft, hard))
            except Exception:
                pass
            try:
                # Also constrain data segment if supported
                desired = 256 * 1024 * 1024
                soft, hard = resource.getrlimit(resource.RLIMIT_DATA)
                new_soft = min(desired, hard if hard != resource.RLIM_INFINITY else desired)
                resource.setrlimit(resource.RLIMIT_DATA, (new_soft, hard))
            except Exception:
                pass
            try:
                # No core dumps
                resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
            except Exception:
                pass
            # Ensure UTF-8 locale/encoding in child
            os.environ['LC_ALL'] = 'C.UTF-8'
            os.environ['LANG'] = 'C.UTF-8'
            # Stabilize glibc arenas for more predictable memory behavior
            os.environ['MALLOC_ARENA_MAX'] = '1'

        # Environment for the child
        env = os.environ.copy()
        env['LC_ALL'] = 'C.UTF-8'
        env['LANG'] = 'C.UTF-8'
        env['MALLOC_ARENA_MAX'] = '1'

        # Execute the original harness: run jq with identity filter "." and feed our large JSON
        with open(tmp_path, 'r', encoding='utf-8') as inf:
            try:
                result = subprocess.run(
                    [exe, "."],
                    stdin=inf,
                    text=True,
                    capture_output=True,
                    timeout=timeout,
                    env=env,
                    preexec_fn=limit_resources,
                )
                return result.stderr, result.returncode
            except subprocess.TimeoutExpired as e:
                return e.stderr or "", -signal.SIGKILL

    finally:
        if tmp_path is not None:
            try:
                os.remove(tmp_path)
            except Exception:
                pass

