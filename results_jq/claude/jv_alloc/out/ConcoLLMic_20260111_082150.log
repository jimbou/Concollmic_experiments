import subprocess
import json
import signal
import time

def test_with_large_input(input_type, size_factor):
    try:
        # Create different types of large inputs
        if input_type == "string":
            # Large string
            large_string = "a" * (size_factor * 10**7)  # size_factor * 10MB
            json_input = json.dumps({"large_string": large_string})
        elif input_type == "array":
            # Large array
            large_array = list(range(size_factor * 10**6))  # size_factor * 1M elements
            json_input = json.dumps(large_array)
        elif input_type == "nested":
            # Deeply nested structure (limited by Python's recursion)
            def create_nested(depth):
                if depth <= 0:
                    return {}
                return {"nested": create_nested(depth - 1)}
            
            # Use a depth that won't hit Python's recursion limit
            nested = create_nested(min(900, size_factor * 100))
            json_input = json.dumps(nested)
        else:
            raise ValueError(f"Unknown input type: {input_type}")
        
        print(f"Created {input_type} JSON with size factor {size_factor}")
        print(f"JSON size: {len(json_input)/10**6:.2f} MB")
        
