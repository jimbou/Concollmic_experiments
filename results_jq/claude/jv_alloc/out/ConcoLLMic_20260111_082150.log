        print("1. Generate the large JSON")
        print("2. Pass it to jq as input")
        print("3. Check if memory allocation fails")
        
    except MemoryError:
        print(f"Memory error creating {input_type} with size factor {size_factor}")
    except Exception as e:
        print(f"Error: {e}")

