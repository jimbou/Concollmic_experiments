import os
import tempfile

# Create a simple shared library that overrides malloc
malloc_override_c = """
#include <stdlib.h>
#include <stdio.h>

static int call_count = 0;
static const int FAIL_AFTER = 100;  // Make malloc fail after this many calls

void* malloc(size_t size) {
    // Get the real malloc
    static void* (*real_malloc)(size_t) = NULL;
    if (!real_malloc) {
        real_malloc = (void* (*)(size_t))dlsym(RTLD_NEXT, "malloc");
    }
    
    call_count++;
    
    // After a certain number of calls, start returning NULL
    if (call_count > FAIL_AFTER) {
        fprintf(stderr, "malloc override: forcing NULL return on call %d (size %zu)\\n", 
                call_count, size);
        return NULL;
    }
    
    return real_malloc(size);
}
"""

# Write code to a temporary file
with tempfile.NamedTemporaryFile(suffix='.c', delete=False) as f:
    f.write(malloc_override_c.encode())
    c_file = f.name

# Show how we would compile and use this
print(f"1. Compile the C file to a shared library:")
print(f"   gcc -shared -fPIC {c_file} -o malloc_override.so -ldl")
print()
print(f"2. Use LD_PRELOAD to make the program use our malloc:")
print(f"   LD_PRELOAD=./malloc_override.so ./temp_executable .")
print()
print("3. This would cause malloc to fail after a certain number of calls")
print("   triggering the target branch in jv_mem_alloc()")

# Clean up
os.unlink(c_file)
