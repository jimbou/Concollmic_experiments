import subprocess
import signal
import json
from pathlib import Path

def execute_program(timeout: int) -> tuple[str, int]:
    exe = "./temp_executable"  # jq binary

    # Create an extremely large JSON input to force memory allocation failure
    # Approach 1: Create a very large string
    try:
        # Try to create a string large enough to cause memory allocation failure
        # Start with a base size that's already quite large
        base_size = 500 * 1024 * 1024  # 500MB
        
        # Create a JSON with a large string and additional complexity
        large_string = "a" * base_size
        
        # Add some nested structure to increase parsing complexity
        json_obj = {
            "large_string": large_string,
            "array": [i for i in range(100000)],  # Additional 100K element array
            "nested": {}
        }
        
        # Add some deep nesting (20 levels)
        current = json_obj["nested"]
        for i in range(20):
            current["level"] = {}
            current = current["level"]
        
        # Convert to JSON string
        json_input = json.dumps(json_obj)
        
    except MemoryError:
        # If we already hit a memory error creating the JSON, use a simpler approach
        # that will still likely cause jq to fail memory allocation
        json_input = json.dumps({
            "large_array": [0] * 50000000  # 50 million element array
        })

    try:
        result = subprocess.run(
            [str(exe), "."],  # FILTER only
            input=json_input,
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return e.stderr or "", -signal.SIGKILL
    except Exception as e:
        # Handle other exceptions that might occur during execution
        return str(e), -1
