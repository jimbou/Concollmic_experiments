import json
import subprocess

# Let's try a deeply nested structure which might cause stack issues
def create_nested_json(depth):
    if depth <= 0:
        return 1
    return [create_nested_json(depth - 1)]

# Test with a moderate depth
try:
    nested = create_nested_json(1000)
    json_str = json.dumps(nested)
    print(f"Successfully created nested JSON with depth 1000, size: {len(json_str)} bytes")
