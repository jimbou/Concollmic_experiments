import subprocess
import signal

def execute_program(timeout: int) -> tuple[str, int]:
    # Construct an XML declaration with a UTF-8 EncName whose byte length exceeds 127
    # Use only valid XML Name characters (ASCII letters) and ensure version appears first.
    enc_name = "A" * 128  # L = 128 > 127, valid Name chars
    # Sanity check: ensure UTF-8 byte length exceeds buffer capacity
    assert len(enc_name.encode("utf-8")) > 127

    xml_input = f"<?xml version=\"1.0\" encoding=\"{enc_name}\"?>\n<root></root>\n"

    try:
        result = subprocess.run(
            ["./temp_executable"],
            input=xml_input,
            text=True,
            encoding="utf-8",   # UTF-8 without BOM
            capture_output=True,
            timeout=timeout,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return e.stderr, -signal.SIGKILL

    except Exception as e:
        raise e
