import subprocess
import signal

def execute_program(timeout: int) -> tuple[str, int]:
    # XML with an oversized encoding attribute value (>127 ASCII chars) to trigger ptr != end in findEncoding.
    # All characters are ASCII; transport is UTF-8 without BOM via text mode.
    long_enc = "A" * 150  # strictly greater than 127
    xml_input = (
        "<?xml version=\"1.0\" encoding=\"" + long_enc + "\" ?>\n"  # note space after closing quote before ?>
        "<r/>\n"
    )

    try:
        result = subprocess.run(
            ["./temp_executable"],   # Same executable, no extra args
            input=xml_input,          # Provide the XML via stdin
            text=True,
            encoding="utf-8",        # Ensure stdin transport is UTF-8 without BOM
            capture_output=True,
            timeout=timeout,
        )
        return result.stderr, result.returncode

    except subprocess.TimeoutExpired as e:
        return e.stderr, -signal.SIGKILL

    except Exception as e:
        raise e
